model AgencyProjectTemplateTask {
  id              String                    @id @default(cuid())
  templateId      String
  milestoneId     String?
  title           String
  description     String?                   @db.Text
  position        Int
  priority        AgencyProjectTaskPriority @default(NORMAL)
  offsetDaysDue   Int?
  clientVisible   Boolean                   @default(false)
  defaultRole     AgencyProjectMemberRole?

  template  AgencyProjectTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  milestone AgencyProjectTemplateMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([templateId, position])
}

model AgencyProjectTemplateRequirement {
  id            String                @id @default(cuid())
  templateId    String
  title         String
  description   String?               @db.Text
  type          AgencyRequirementType @default(OTHER)
  offsetDaysDue Int?
  clientVisible Boolean               @default(true)

  template AgencyProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AgencyProjectMilestone {
  id            String                @id @default(cuid())
  projectId     String
  title         String
  description   String?               @db.Text
  status        AgencyMilestoneStatus @default(NOT_STARTED)
  position      Int
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  clientVisible Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project      AgencyProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        AgencyProjectTask[]
  requirements AgencyClientRequirement[]
  deliverables AgencyDeliverable[]

  @@index([projectId, position])
  @@index([projectId, status])
}

model AgencyProjectTask {
  id             String                    @id @default(cuid())
  projectId      String
  milestoneId    String?
  title          String
  description    String?                   @db.Text
  status         AgencyProjectTaskStatus   @default(TODO)
  priority       AgencyProjectTaskPriority @default(NORMAL)
  assigneeId     String?
  createdById    String
