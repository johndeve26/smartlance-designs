model AgencyProject {
  id                     String              @id @default(cuid())
  projectNumber          String              @unique
  name                   String
  clientCompanyId        String?
  primaryContactId       String
  sourceDealId           String?             @unique
  serviceType            AgencyServiceType
  customServiceName      String?
  cmsServiceSlug         String?
  status                 AgencyProjectStatus @default(PLANNING)
  health                 AgencyProjectHealth @default(ON_TRACK)
  ownerId                String
  startDate              DateTime?
  targetDueDate            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  budgetSnapshot         Decimal?            @db.Decimal(12, 2)
  currency               String?             @default("USD")
  summary                String?             @db.Text
  internalNotes          String?             @db.Text
  clientVisibilityEnabled Boolean            @default(true)
  caseStudyCandidate     Boolean             @default(false)
  createdById            String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  clientCompany   CrmCompany?  @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  primaryContact  CrmContact   @relation(fields: [primaryContactId], references: [id], onDelete: Restrict)
  sourceDeal      CrmDeal?     @relation(fields: [sourceDealId], references: [id], onDelete: SetNull)
  owner           AdminUser    @relation("AgencyProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       AdminUser    @relation("AgencyProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  members       AgencyProjectMember[]
  milestones    AgencyProjectMilestone[]
  tasks         AgencyProjectTask[]
  requirements  AgencyClientRequirement[]
  deliverables  AgencyDeliverable[]
  activities    AgencyProjectActivity[]
  updates       AgencyProjectUpdate[]
  notes         AgencyProjectNote[]
  clientAccess  AgencyProjectClientAccess[]
  files         AgencyProjectFile[]
  portalInvites ClientPortalInvite[]

  @@index([status, targetDueDate])
  @@index([ownerId, status])
  @@index([clientCompanyId])
  @@index([primaryContactId])
  @@index([createdAt])
}

model AgencyProjectMember {
  id        String                  @id @default(cuid())
  projectId String
  userId    String
  role      AgencyProjectMemberRole @default(MEMBER)
  createdAt DateTime                @default(now())

  project AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    AdminUser     @relation("AgencyProjectMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AgencyProjectTemplate {
