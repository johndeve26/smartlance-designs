model CrmCompany {
  id          String   @id @default(cuid())
  name        String
  website     String?
  domain      String?
  industry    String?
  phone       String?
  location    String?
  address     String?  @db.Text
  sizeLabel   String?
  description String?  @db.Text
  ownerId     String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    AdminUser?   @relation("CrmCompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts CrmContact[]
  leads    CrmLead[]
  deals    CrmDeal[]
  tasks    CrmTask[]
  activities CrmActivity[]
  agencyProjects AgencyProject[]

  @@index([name])
  @@index([domain])
  @@index([ownerId])
  @@index([isArchived, updatedAt])
}

model CrmContact {
  id               String                   @id @default(cuid())
  firstName        String?
  lastName         String?
  displayName      String?
  email            String?
  emailNormalized  String?                  @unique
  phone            String?
  jobTitle         String?
  companyId        String?
  lifecycleStage   CrmContactLifecycleStage @default(PROSPECT)
  source           CrmContactSource         @default(MANUAL)
  sourceDetail     String?
  sourceUrl        String?
  ownerId          String?
  emailStatus      CrmContactEmailStatus    @default(SENDABLE)
  lastContactedAt  DateTime?
  nextActivityAt   DateTime?
  outreachPaused   Boolean                  @default(false)
  outreachPausedAt DateTime?
  manualRepliedAt  DateTime?
  countryCode      String?
  countryName      String?
  stateRegion      String?
  city             String?
  postalCode       String?
  timezone         String?
  isArchived       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdById      String?

  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner     AdminUser?  @relation("CrmContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy AdminUser?  @relation("CrmContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leads     CrmLead[]
  deals     CrmDeal[]
  tasks     CrmTask[]
  activities CrmActivity[]
  emails    CrmEmail[]
  emailThreads CrmEmailThread[]
  sequenceEnrollments CrmSequenceEnrollment[]
  outreachOptOut      CrmOutreachOptOut?
  socialProfiles      CrmContactSocialProfile[]
  propertyValues      CrmContactPropertyValue[]
  agencyProjects      AgencyProject[]
  portalUser          ClientPortalUser?
  deliverableReviews  AgencyDeliverableReview[]
  clientProjectAccess AgencyProjectClientAccess[]

  @@index([companyId])
  @@index([lifecycleStage])
  @@index([source])
  @@index([ownerId])
  @@index([emailStatus])
  @@index([isArchived, updatedAt])
  @@index([nextActivityAt])
  @@index([countryCode])
  @@index([city])
}

model CrmLead {
  id                     String                          @id @default(cuid())
  contactId              String
  companyId              String?
  status                 CrmLeadStatus                   @default(NEW)
  temperature            CrmLeadTemperature              @default(COLD)
  source                 CrmContactSource                @default(MANUAL)
  ownerId                String?
  interestSummary        String?                         @db.Text
  servicesInterested     String[]                        @default([])
  estimatedValue         Decimal?                        @db.Decimal(12, 2)
  currency               String?                         @default("USD")
  nextFollowUpAt         DateTime?
  qualifiedAt            DateTime?
  disqualifiedAt         DateTime?
  disqualificationReason CrmLeadDisqualificationReason?
  disqualificationNote   String?                         @db.Text
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  contact CrmContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner   AdminUser?  @relation("CrmLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals   CrmDeal[]
  tasks   CrmTask[]
  activities CrmActivity[]
  emails     CrmEmail[]
  emailThreads CrmEmailThread[]
  enrollments CrmSequenceEnrollment[]

  @@index([contactId, status])
  @@index([status])
  @@index([temperature])
  @@index([ownerId])
  @@index([source])
  @@index([nextFollowUpAt])
}

model CrmDeal {
  id                 String         @id @default(cuid())
  title              String
  contactId          String
  companyId          String?
  leadId             String?
  ownerId            String?
  stage              CrmDealStage   @default(NEW_OPPORTUNITY)
  amount             Decimal?       @db.Decimal(12, 2)
  currency           String?        @default("USD")
  probability        Int?
  expectedCloseAt    DateTime?
  servicesInterested String[]       @default([])
  proposalSentAt     DateTime?
  wonAt              DateTime?
  lostAt             DateTime?
  lostReason         CrmDealLostReason?
  lostNote           String?        @db.Text
  isArchived         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contact CrmContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead    CrmLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner   AdminUser?  @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   CrmTask[]
  activities CrmActivity[]
  emails  CrmEmail[]
  emailThreads CrmEmailThread[]
  agencyProject AgencyProject?

  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([stage])
  @@index([ownerId])
  @@index([isArchived, updatedAt])
  @@index([expectedCloseAt])
}

model CrmActivity {
  id          String          @id @default(cuid())
  contactId   String
  companyId   String?
  leadId      String?
  dealId      String?
  type        CrmActivityType
  subject     String?
  body        String?         @db.Text
  metadata    Json?
  occurredAt  DateTime        @default(now())
  createdById String?
  createdAt   DateTime        @default(now())

  contact   CrmContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead      CrmLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy AdminUser?  @relation("CrmActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([type, occurredAt])
}

model CrmTask {
  id           String          @id @default(cuid())
  title        String
  description  String?         @db.Text
  contactId    String?
  companyId    String?
  leadId       String?
  dealId       String?
  emailThreadId String?
  taskType     CrmTaskType     @default(GENERAL)
  assignedToId String?
  priority     CrmTaskPriority @default(NORMAL)
  status       CrmTaskStatus   @default(OPEN)
  dueAt        DateTime?
  completedAt  DateTime?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contact     CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead        CrmLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal        CrmDeal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  emailThread CrmEmailThread? @relation(fields: [emailThreadId], references: [id], onDelete: SetNull)
  assignedTo  AdminUser?      @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   AdminUser       @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([emailThreadId, status, taskType])
}

model CrmEmail {
