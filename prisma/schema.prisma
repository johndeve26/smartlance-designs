  submittedByPortalUser ClientPortalUser?       @relation("AgencyOnboardingFileSubmissionPortalUser", fields: [submittedByPortalUserId], references: [id], onDelete: SetNull)

  @@index([onboardingId])
  @@index([requirementId])
  @@index([questionId])
