  WAIT_FOR_TASK_COMPLETION
}

enum CrmSequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CrmSequenceStopReason {
  SUPPRESSED
  ARCHIVED
  LEAD_DISQUALIFIED
