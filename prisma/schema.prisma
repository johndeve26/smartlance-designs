generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  CONTENT_MANAGER
  REVIEWER
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum RedirectStatus {
  ACTIVE
  DISABLED
}

enum RedirectOrigin {
  SLUG_CHANGE
  LEGACY_MIGRATION
  MANUAL
}

enum MediaSourceType {
  STATIC_EXISTING
  UPLOADED
  EXTERNAL
}

enum MediaAssetStatus {
  ACTIVE
  ARCHIVED
}

enum NavigationMenuKey {
  HEADER_PRIMARY
  HEADER_RESOURCES
  HEADER_SERVICES
  HEADER_SEO
  HEADER_PLATFORMS
  HEADER_CTA
  FOOTER_SERVICES
  FOOTER_SEO
  FOOTER_PLATFORMS
  FOOTER_COMPANY
  FOOTER_RESOURCES
  FOOTER_LEGAL
}

enum NavigationItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LinkHealthIssueType {
  BROKEN
  REDIRECTING
  UNPUBLISHED_DESTINATION
  ORPHAN
  INVALID_RELATION
  CANONICAL_MISMATCH
  OPTIONAL_WARNING
}

enum LinkHealthSeverity {
  ERROR
  WARNING
  INFO
}

enum EnquiryType {
  CONTACT
  WEBSITE_REVIEW
}

enum EnquiryStatus {
  NEW
  REVIEWING
  REPLIED
  QUALIFIED
  CLOSED
  SPAM
}

enum NotificationStatus {
  NOT_ATTEMPTED
  SENT
  FAILED
}

model AdminUser {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         AdminRole       @default(EDITOR)
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sessions          AdminSession[]
  auditLogs         AuditLog[]       @relation("AuditActor")
  contentRevisions  ContentRevision[] @relation("RevisionAuthor")
  redirectsCreated  Redirect[]       @relation("RedirectCreator")
  servicesCreated   Service[]        @relation("ServiceCreator")
  servicesUpdated   Service[]        @relation("ServiceUpdater")
  solutionsCreated  Solution[]       @relation("SolutionCreator")
  solutionsUpdated  Solution[]       @relation("SolutionUpdater")
  platformsCreated  Platform[]       @relation("PlatformCreator")
  platformsUpdated  Platform[]       @relation("PlatformUpdater")
  homepageUpdated   HomepageContent[] @relation("HomepageUpdater")
  homepageDraftUpdated HomepageContent[] @relation("HomepageDraftUpdater")
  industriesCreated Industry[]       @relation("IndustryCreator")
  industriesUpdated Industry[]       @relation("IndustryUpdater")
  workCreated       WorkProject[]    @relation("WorkCreator")
  workUpdated       WorkProject[]    @relation("WorkUpdater")
  testimonialsCreated Testimonial[]  @relation("TestimonialCreator")
  testimonialsUpdated Testimonial[]  @relation("TestimonialUpdater")
  insightsCreated   Insight[]        @relation("InsightCreator")
  insightsUpdated   Insight[]        @relation("InsightUpdater")
  resourcesCreated  CmsResource[]    @relation("ResourceCreator")
  resourcesUpdated  CmsResource[]    @relation("ResourceUpdater")
  mediaCreated      MediaAsset[]     @relation("MediaCreator")
  mediaUpdated      MediaAsset[]     @relation("MediaUpdater")
  navMenusUpdated   NavigationMenu[] @relation("NavMenuUpdater")
  managedPagesUpdated ManagedPage[]  @relation("ManagedPageUpdater")
  linkHealthRuns    LinkHealthRun[]  @relation("LinkHealthRunner")
  enquiryNotes      EnquiryNote[]    @relation("EnquiryNoteAuthor")
  enquiriesUpdated  Enquiry[]        @relation("EnquiryUpdater")
  aiProjectsCreated AIEditorialProject[] @relation("AIProjectCreator")
  aiProjectsUpdated AIEditorialProject[] @relation("AIProjectUpdater")
  aiProjectsApproved AIEditorialProject[] @relation("AIProjectApprover")
  aiRunsCreated     AIEditorialRun[]     @relation("AIRunCreator")
  aiBrandVoicesUpdated AIBrandVoice[]    @relation("AIBrandVoiceUpdater")
  aiEvaluationSnapshots AIEvaluationSnapshot[] @relation("AIEvaluationCreator")
  aiProviderAccountsUpdated AIProviderAccount[] @relation("AIProviderAccountUpdater")
  topicSeedsCreated         TopicSeed[]              @relation("TopicSeedCreator")
  topicOpportunitiesReviewed EditorialOpportunity[]  @relation("TopicOpportunityReviewer")
  topicDiscoveryRuns        TopicDiscoveryRun[]      @relation("TopicDiscoveryRunner")
  topicSourcePacksUpdated   TopicSourcePack[]        @relation("TopicSourcePackUpdater")
  topicWatchlistsUpdated    TopicWatchlist[]         @relation("TopicWatchlistUpdater")
  aiContentRunsCreated      AIContentRun[]           @relation("AIContentRunCreator")
  aiContentProposalsCreated AIContentProposal[]      @relation("AIContentProposalCreator")
  aiContentProposalsAccepted AIContentProposal[]     @relation("AIContentProposalAcceptor")

  @@index([status])
  @@index([role])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipHash    String?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  revision   Int
  snapshot   Json
  createdById String?
  createdAt  DateTime @default(now())

  createdBy AdminUser? @relation("RevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, revision])
  @@index([entityType, entityId])
}

model Redirect {
  id          String         @id @default(cuid())
  sourcePath  String         @unique
  destination String
  type        RedirectType   @default(PERMANENT_301)
  status      RedirectStatus @default(ACTIVE)
  origin      RedirectOrigin @default(MANUAL)
  reason      String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy AdminUser? @relation("RedirectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([origin])
}

model SiteSettings {
  id                     String   @id @default("site")
  siteName               String   @default("Smartlance Designs")
  businessName           String   @default("Smartlance Designs")
  defaultSiteDescription String?
  defaultLocale          String   @default("en")
  timezone               String   @default("Africa/Lagos")
  canonicalHost          String?
  contactEmail           String?
  contactPhone           String?
  whatsapp               String?
  footerDescription      String?
  primaryLogoPath        String?
  logoOnDarkPath         String?
  brandMarkPath          String?
  faviconPath            String?
  defaultMetaTitle       String?
  defaultMetaDescription String?
  defaultOgImagePath     String?
  defaultTitleTemplate   String?
  publisherName          String?
  /// Public analytics IDs only (never secrets)
  gaMeasurementId        String?
  gtmContainerId         String?
  clarityProjectId       String?
  analyticsEnabled       Boolean  @default(true)
  contactFormEnabled     Boolean  @default(true)
  freeReviewFormEnabled  Boolean  @default(true)
  formSuccessMessage     String?
  formFallbackMessage    String?
  showPublicPricing      Boolean  @default(false)
  robotsDefaultIndex     Boolean  @default(true)
  /// [{ platform, url, enabled, displayOrder }]
  socialLinks            Json     @default("[]")
  /// Flexible extras (never secrets)
  extras                 Json     @default("{}")
  updatedAt              DateTime @updatedAt
  updatedById            String?
}

model HomepageContent {
  id                     String    @id @default("home")
  heroEyebrow            String
  heroHeadline           String
  heroHeadlineAccent     String?
  heroSupporting         String
  primaryCtaLabel        String
  primaryCtaHref         String
  secondaryCtaLabel      String
  secondaryCtaHref       String
  metaTitle              String?
  metaDescription        String?
  sections               Json
  sectionVisibility      Json
  curatedServiceItems    Json
  curatedTestimonialIds  Json
  seoTitle               String?
  seoDescription         String?
  ogTitle                String?
  ogDescription          String?
  ogImagePath            String?
  noIndex                Boolean   @default(false)
  canonicalOverride      String?
  /// Unpublished editor/AI draft — public site never reads this until publish
  draftJson              Json?
  draftUpdatedAt         DateTime?
  draftUpdatedById       String?
  updatedById            String?
  updatedAt              DateTime  @updatedAt

  updatedBy      AdminUser? @relation("HomepageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  draftUpdatedBy AdminUser? @relation("HomepageDraftUpdater", fields: [draftUpdatedById], references: [id], onDelete: SetNull)
}

model Service {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  href                 String        @unique
  title                String
  shortTitle           String?
  category             String
  group                String
  icon                 String
  summary              String
  description          String        @db.Text
  tagline              String?
  narrativeTitle       String?
  narrative            String?       @db.Text
  seoConnection        String?       @db.Text
  audience             String?
  platformsNote        String?
  visualVariant        String?
  featured             Boolean       @default(false)
  navigationFeatured   Boolean       @default(false)
  displayOrder         Int           @default(0)
  capabilities         Json?
  idealFor             Json?
  problems             Json?
  deliverables         Json?
  process              Json?
  evaluationItems      Json?
  faqs                 Json?
  relatedProjectSlugs  Json?
  relatedServiceSlugs  Json?
  relatedSeoSlugs      Json?
  relatedPlatformSlugs Json?
  relatedSolutionSlugs Json?
  ctaTitle             String?
  ctaDescription       String?       @db.Text
  primaryCtaLabel      String?
  primaryCtaHref       String?
  secondaryCtaLabel    String?
  secondaryCtaHref     String?
  seoTitle             String
  seoDescription       String
  ogTitle              String?
  ogDescription        String?
  ogImagePath          String?
  noIndex              Boolean       @default(false)
  canonicalOverride    String?
  status               PublishStatus @default(DRAFT)
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  createdBy AdminUser? @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("ServiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([group])
  @@index([displayOrder])
}

model Solution {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  name                   String
  title                  String
  shortDescription       String        @db.Text
  category               String
  icon                   String
  featured               Boolean       @default(false)
  displayOrder           Int           @default(0)
  eyebrow                String?
  heroStatement          String?       @db.Text
  heroSupporting         String?       @db.Text
  problemSymptoms        Json?
  possibleCauses         Json?
  whatWeReview           Json?
  process                Json?
  measurementPoints      Json?
  relatedServiceHrefs    Json
  relatedPlatformSlugs   Json?
  relatedIndustrySlugs   Json?
  relatedProjectSlugs    Json?
  relatedArticleSlugs    Json?
  relatedServiceReasons  Json?
  relatedSolutions       Json?
  faqs                   Json?
  pageKind               String?
  pageContent            Json?
  ctaTitle               String?
  ctaDescription         String?       @db.Text
  primaryCtaLabel        String?
  primaryCtaHref         String?
  secondaryCtaLabel      String?
  secondaryCtaHref       String?
  seoTitle               String?
  seoDescription         String?
  ogTitle                String?
  ogDescription          String?
  ogImagePath            String?
  noIndex                Boolean       @default(false)
  canonicalOverride      String?
  status                 PublishStatus @default(DRAFT)
  publishedAt            DateTime?
  createdById            String?
  updatedById            String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  createdBy AdminUser? @relation("SolutionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("SolutionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@index([displayOrder])
}

model Platform {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  href                 String        @unique
  name                 String
  title                String
  summary              String
  description          String        @db.Text
  tagline              String?
  icon                 String
  group                String
  prominence           String?
  featured             Boolean       @default(false)
  navigationFeatured   Boolean       @default(false)
  verifiedExperience   Boolean       @default(false)
  platformMatch        String
  displayOrder         Int           @default(0)
  audiences            Json
  whenItFits           Json?
  capabilities         Json
  challenges           Json?
  seoSection           Json?
  relatedServiceHrefs  Json
  relatedSeoHrefs      Json?
  faqs                 Json?
  legacyUrl            String?
  conversionNote       String?       @db.Text
  migrationNote        String?       @db.Text
  ctaTitle             String?
  ctaDescription       String?       @db.Text
  seoTitle             String
  seoDescription       String
  ogTitle              String?
  ogDescription        String?
  ogImagePath          String?
  noIndex              Boolean       @default(false)
  canonicalOverride    String?
  lastReviewedAt       DateTime?
  status               PublishStatus @default(DRAFT)
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  createdBy AdminUser? @relation("PlatformCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("PlatformUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  workProjects WorkProject[]

  @@index([status])
  @@index([publishedAt])
  @@index([group])
  @@index([displayOrder])
}

/* -------------------------------------------------------------------------- */
/* Phase 3 — Proof, Industries, Insights, Resources                           */
/* -------------------------------------------------------------------------- */

enum IndustryGroupKind {
  proven
  supported
}

enum ResourceKind {
  guide
  comparison
  checklist
  glossary
  template
  tool
}

enum CurationPlacement {
  RESOURCES_HUB
  HOMEPAGE_WORK
  HOMEPAGE_INSIGHT
  WORK_ARCHIVE
}

model Topic {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  insights  InsightTopic[]
  resources CmsResourceTopic[]

  @@index([active, displayOrder])
}

model Industry {
  id                          String            @id @default(cuid())
  slug                        String            @unique
  name                        String
  description                 String            @db.Text
  icon                        String
  group                       IndustryGroupKind
  featured                    Boolean           @default(false)
  displayOrder                Int               @default(0)
  hasVerifiedProjectExperience Boolean          @default(false)
  relatedServiceLinks         Json
  relatedSolutionSlugs        Json?
  seoTitle                    String?
  seoDescription              String?
  ogTitle                     String?
  ogDescription               String?
  ogImagePath                 String?
  noIndex                     Boolean           @default(false)
  canonicalOverride           String?
  status                      PublishStatus     @default(DRAFT)
  publishedAt                 DateTime?
  createdById                 String?
  updatedById                 String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  createdBy AdminUser? @relation("IndustryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("IndustryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  workLinks IndustryWork[]

  @@index([status])
  @@index([group])
  @@index([displayOrder])
  @@index([hasVerifiedProjectExperience])
}

enum CaseStudyKind {
  WEBSITE
  PRODUCT
}

model WorkProject {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  name                 String
  title                String?
  clientName           String?
  industryLabel        String
  projectType          String?
  shortDescription     String?       @db.Text
  overview             String?       @db.Text
  challenge            String        @db.Text
  solution             String        @db.Text
  approach             String?       @db.Text
  designNotes          String?       @db.Text
  developmentNotes     String?       @db.Text
  seoNotes             String?       @db.Text
  resultSummary        String?       @db.Text
  results              Json?
  measurableResults    Json?
  goals                Json?
  servicesLabels       Json
  technologies         Json?
  platformId           String?
  platformLabel        String?
  platformsLabels      Json?
  websiteUrl           String?
  oldUrl               String?
  year                 Int?
  coverImagePath       String?
  coverImageAlt        String?
  heroImagePath        String?
  heroImageAlt         String?
  gallery              Json?
  relatedServiceHrefs  Json?
  relatedWorkSlugs     Json?
  featuredHomepage     Boolean       @default(false)
  featuredWorkArchive  Boolean       @default(false)
  featured             Boolean       @default(false)
  displayOrder         Int           @default(0)
  heroStatement        String?       @db.Text
  challenges           Json?
  approachSteps        Json?
  solutionPoints       Json?
  highlights           Json?
  platformContext      String?       @db.Text
  outcomeHeading       String?
  caseStudyKind        CaseStudyKind @default(WEBSITE)
  /// Versioned structured case-study presentation ({ version: 1, ... })
  caseStudyContent     Json?
  heroEyebrow          String?
  heroSupportingCopy   String?       @db.Text
  externalLinkLabel    String?
  draftJson            Json?
  draftUpdatedAt       DateTime?
  draftUpdatedById     String?
  seoTitle             String
  seoDescription       String
  ogTitle              String?
  ogDescription        String?
  ogImagePath          String?
  noIndex              Boolean       @default(false)
  canonicalOverride    String?
  /// Explicit opt-in: approved project facts may be sent to AI when an editor invokes Case Study AI
  approvedForAI        Boolean       @default(false)
  /// Structured verified project facts for Case Study AI (not public page copy)
  /// { objective, problem, workCompleted, deliverables[], technology[], platform, clientContext, outcome, verifiedMetrics[] }
  approvedProjectFacts Json?
  status               PublishStatus @default(DRAFT)
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  platform     Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)
  createdBy    AdminUser?     @relation("WorkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    AdminUser?     @relation("WorkUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  industryLinks IndustryWork[]
  testimonials Testimonial[]

  @@index([status])
  @@index([publishedAt])
  @@index([displayOrder])
  @@index([featuredHomepage])
  @@index([featuredWorkArchive])
  @@index([platformId])
}

model IndustryWork {
  industryId String
  workId     String
  sortOrder  Int    @default(0)

  industry Industry    @relation(fields: [industryId], references: [id], onDelete: Cascade)
  work     WorkProject @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([industryId, workId])
  @@index([workId])
}

model Testimonial {
  id                       String        @id @default(cuid())
  legacyId                 String        @unique
  /// Working display quote (may receive safe punctuation normalization only)
  quote                    String        @db.Text
  /// Immutable verified source wording — preserved exactly; never inventively rewritten
  originalQuote            String?       @db.Text
  /// Optional shorter display excerpt derived from originalQuote (extraction only)
  displayExcerpt           String?       @db.Text
  name                     String
  role                     String?
  company                  String
  serviceLabel             String?
  avatarPath               String?
  workProjectId            String?
  verified                 Boolean       @default(false)
  featured                 Boolean       @default(false)
  displayOrder             Int           @default(0)
  /// Internal editorial themes (optional metadata — not public copy)
  themesJson               Json?
  internalSource           String?
  internalSourceUrl        String?
  internalVerificationNote String?       @db.Text
  status                   PublishStatus @default(DRAFT)
  publishedAt              DateTime?
  createdById              String?
  updatedById              String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  workProject WorkProject? @relation(fields: [workProjectId], references: [id], onDelete: SetNull)
  createdBy   AdminUser?   @relation("TestimonialCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser?   @relation("TestimonialUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([verified])
  @@index([displayOrder])
  @@index([workProjectId])
}

model Insight {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  description         String        @db.Text
  bodyMarkdown        String        @db.Text
  categoryLabel       String
  author              String?
  readingTime         String?
  heroImagePath       String?
  heroImageAlt        String?
  relatedServiceHrefs Json?
  tags                Json?
  featured            Boolean       @default(false)
  legacyUrl           String?
  originalPublishedAt DateTime
  materialUpdatedAt   DateTime?
  seoTitle            String?
  seoDescription      String?
  ogTitle             String?
  ogDescription       String?
  ogImagePath         String?
  noIndex             Boolean       @default(false)
  canonicalOverride   String?
  status              PublishStatus @default(DRAFT)
  publishedAt         DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  createdBy AdminUser?     @relation("InsightCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser?     @relation("InsightUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  topics    InsightTopic[]
  aiProject AIEditorialProject?

  @@index([status])
  @@index([publishedAt])
  @@index([originalPublishedAt])
  @@index([categoryLabel])
  @@index([featured])
}

model InsightTopic {
  insightId String
  topicId   String

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([insightId, topicId])
  @@index([topicId])
}

/** Non-insight resource types (guide, comparison, checklist, glossary, template, tool). */
model CmsResource {
  id                  String        @id @default(cuid())
  type                ResourceKind
  slug                String
  title               String
  description         String        @db.Text
  deck                String?       @db.Text
  href                String
  payload             Json
  featured            Boolean       @default(false)
  featuredOnResources Boolean       @default(false)
  featuredOrder       Int           @default(0)
  readingTime         String?
  author              String?
  heroImagePath       String?
  heroImageAlt        String?
  relatedServiceHrefs Json?
  relatedSolutionSlugs Json?
  relatedPlatformSlugs Json?
  relatedInsightSlugs Json?
  relatedResourceIds  Json?
  aliases             Json?
  acronym             String?
  shortDefinition     String?       @db.Text
  seoTitle            String?
  seoDescription      String?
  ogTitle             String?
  ogDescription       String?
  ogImagePath         String?
  noIndex             Boolean       @default(false)
  canonicalOverride   String?
  status              PublishStatus @default(DRAFT)
  publishedAt         DateTime?
  materialUpdatedAt   DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  createdBy AdminUser?         @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser?         @relation("ResourceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  topics    CmsResourceTopic[]

  @@unique([type, slug])
  @@index([status])
  @@index([type, status])
  @@index([publishedAt])
  @@index([featuredOnResources, featuredOrder])
}

model CmsResourceTopic {
  resourceId String
  topicId    String

  resource CmsResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic    Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([resourceId, topicId])
  @@index([topicId])
}

model ContentCuration {
  id         String            @id @default(cuid())
  placement  CurationPlacement
  entityType String
  entityId   String
  sortOrder  Int               @default(0)
  active     Boolean           @default(true)
  updatedAt  DateTime          @updatedAt
  createdAt  DateTime          @default(now())

  @@unique([placement, entityType, entityId])
  @@index([placement, active, sortOrder])
}

model AssetReference {
  id        String   @id @default(cuid())
  path      String   @unique
  alt       String?
  kind      String
  entityHint String?
  createdAt DateTime @default(now())

  @@index([kind])
}

model ContentImportMarker {
  id          String   @id
  version     String
  report      Json?
  completedAt DateTime @default(now())
}

model MediaAsset {
  id               String           @id @default(cuid())
  filename         String
