  humanDecisionNote     String?                @db.Text
  editorialFeedback     TopicEditorialFeedback?
  editorialFeedbackNote String?                @db.Text
  intent                String?
  audience              String?
  market                String?
  timeliness            TopicFreshnessClass    @default(HYBRID)
  evergreenPotential    Boolean                @default(true)
  commercialRelationship String?               @db.Text
  uniqueValue           String?                @db.Text
  reasonToExist         String?                @db.Text
  whyNow                String?                @db.Text
  whySmartlance         String?                @db.Text
  existingContentJson   Json?
  supportingSignalsJson Json?
  sourceSummaryJson     Json?
  suggestedServicesJson Json?
  suggestedSolutionsJson Json?
  suggestedPlatformsJson Json?
  suggestedResourcesJson Json?
  /// Resolved CMS target for handoffs (optional; preferred over title matching)
  targetEntityType      String?
  targetEntityId        String?
  suggestedFormat       TopicContentFormat     @default(INSIGHT)
  suggestedCta          String?
  dimensionsJson        Json?
  badge                 String?
  priority              TopicPriority          @default(NORMAL)
  pinned                Boolean                @default(false)
  plannedFor            DateTime?
  rejectionReason       TopicRejectionReason?
  rejectionNote         String?                @db.Text
  higherFactualReview   Boolean                @default(false)
  mergeKey              String?
  evidenceCount         Int                    @default(0)
  recurringSignal       Boolean                @default(false)
  seedId                String?
  runId                 String?
  linkedAIProjectId     String?                @unique
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  seed            TopicSeed?         @relation(fields: [seedId], references: [id], onDelete: SetNull)
  run             TopicDiscoveryRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewedBy      AdminUser?         @relation("TopicOpportunityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  linkedAIProject AIEditorialProject? @relation(fields: [linkedAIProjectId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([recommendation, status])
  @@index([mergeKey])
  @@index([priority, status])
  @@index([market])
}
