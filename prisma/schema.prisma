model AgencyOnboardingActivity {
  id                String                     @id @default(cuid())
  onboardingId      String
  type              AgencyOnboardingActivityType
  summary           String
  actorUserId       String?
  actorPortalUserId String?
  entityType        String?
  entityId          String?
  metadata          Json?
  clientVisible     Boolean                    @default(false)
  createdAt         DateTime                   @default(now())

  onboarding        AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  actorUser         AdminUser?              @relation("AgencyOnboardingActivityAdmin", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPortalUser   ClientPortalUser?       @relation("AgencyOnboardingActivityPortal", fields: [actorPortalUserId], references: [id], onDelete: SetNull)

  @@index([onboardingId, createdAt])
}

model AgencyOnboardingReminder {
  id                    String                       @id @default(cuid())
  onboardingId          String
  requirementId         String?
  questionId            String?
  recipientContactId    String?
  recipientPortalUserId String?
  type                  AgencyOnboardingReminderType @default(ONBOARDING)
  dedupeKey             String                       @unique
  scheduledFor          DateTime?
  sentAt                DateTime?
  status                AgencyOnboardingReminderStatus @default(PENDING)
  attemptCount          Int                          @default(0)
  createdAt             DateTime                     @default(now())

  onboarding          AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  requirement         AgencyClientRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  question            AgencyOnboardingQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  recipientContact    CrmContact?             @relation("AgencyOnboardingReminderContact", fields: [recipientContactId], references: [id], onDelete: SetNull)
  recipientPortalUser ClientPortalUser?       @relation("AgencyOnboardingReminderPortalUser", fields: [recipientPortalUserId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([onboardingId])
}

