  @@index([contactId, createdAt])
  @@index([contactId, receivedAt])
  @@index([contactId, firstOpenDetectedAt])
  @@index([contactId, firstClickDetectedAt])
  @@index([dealId])
  @@index([leadId])
  @@index([enrollmentId])
  @@index([origin, createdAt])
  @@index([direction, receivedAt])
  @@index([reviewStatus, receivedAt])
  @@index([threadId, receivedAt])
