model CrmSegment {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  filterJson    Json
  filterVersion Int      @default(1)
  isDynamic     Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy AdminUser @relation("CrmSegmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([updatedAt])
  @@index([createdById])
}

model CrmSequence {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  status      CrmSequenceStatus @default(DRAFT)
  version     Int               @default(1)
  createdById String
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy   AdminUser              @relation("CrmSequenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   AdminUser?             @relation("CrmSequenceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  steps       CrmSequenceStep[]
  enrollments CrmSequenceEnrollment[]

  @@index([status, updatedAt])
}

model CrmSequenceStep {
  id               String                     @id @default(cuid())
  sequenceId       String
  position         Int
  type             CrmSequenceStepType
  delayDays        Int                        @default(0)
  delayMinutes     Int                        @default(0)
  emailTemplateId  String?
  subject          String?
  body             String?                    @db.Text
  taskTitle        String?
  taskDescription  String?                    @db.Text
  taskAdvanceMode  CrmSequenceTaskAdvanceMode @default(AUTO_CONTINUE)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  sequence      CrmSequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  emailTemplate CrmEmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  executions    CrmSequenceExecution[]

  @@unique([sequenceId, position])
  @@index([sequenceId])
}

model CrmSequenceEnrollment {
  id              String                      @id @default(cuid())
  sequenceId      String
  sequenceVersion Int
  contactId       String
  leadId          String?
  status          CrmSequenceEnrollmentStatus @default(ACTIVE)
  currentStep     Int                         @default(0)
  nextRunAt       DateTime?
  startedAt       DateTime                    @default(now())
  pausedAt        DateTime?
  completedAt     DateTime?
  stoppedAt       DateTime?
  stopReason      CrmSequenceStopReason?
  stopNote        String?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  sequence   CrmSequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact    CrmContact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead       CrmLead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy  AdminUser              @relation("CrmEnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  executions CrmSequenceExecution[]
  emails     CrmEmail[]

  @@index([status, nextRunAt])
  @@index([contactId])
  @@index([sequenceId, status])
}

model CrmSequenceExecution {
  id             String                     @id @default(cuid())
  enrollmentId   String
  stepId         String
  status         CrmSequenceExecutionStatus @default(PENDING)
  scheduledAt    DateTime
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  executedAt     DateTime?
  failureCode    String?
  failureCategory String?
  attemptCount   Int                        @default(0)
  skipReason     String?
  subjectSnap    String?
  bodySnap       String?                    @db.Text
  createdTaskId  String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  enrollment CrmSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       CrmSequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  email      CrmEmail?

  @@unique([enrollmentId, stepId])
  @@index([status, scheduledAt])
  @@index([enrollmentId])
}

model CrmOutreachSettings {
  id                        String   @id @default("outreach")
