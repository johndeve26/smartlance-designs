  ipHash         String?
  metadataJson   Json?
  createdAt      DateTime                    @default(now())

  crmEmail    CrmEmail       @relation(fields: [crmEmailId], references: [id], onDelete: Cascade)
  trackedLink CrmTrackedLink? @relation(fields: [trackedLinkId], references: [id], onDelete: SetNull)

  @@index([crmEmailId, occurredAt])
  @@index([type, occurredAt])
  @@index([trackedLinkId, occurredAt])
}

model CrmEmailTemplate {
