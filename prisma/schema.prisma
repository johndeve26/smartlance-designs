  contract                AgencyContract?               @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner                   AdminUser?                    @relation("AgencyChangeRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requestedByPortalUser   ClientPortalUser?             @relation("AgencyChangeRequestPortalRequester", fields: [requestedByPortalUserId], references: [id], onDelete: SetNull)
  requestedByAdminUser    AdminUser?                    @relation("AgencyChangeRequestAdminRequester", fields: [requestedByAdminUserId], references: [id], onDelete: SetNull)
  requestedByContact      CrmContact?                   @relation("AgencyChangeRequestContactRequester", fields: [requestedByContactId], references: [id], onDelete: SetNull)
  createdBy               AdminUser                       @relation("AgencyChangeRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)

  revisions     AgencyChangeRequestRevision[]
  assessments   AgencyChangeRequestAssessment[]
  clientAccess  AgencyChangeRequestClientAccess[]
  approval      AgencyChangeRequestApproval?
  decision      AgencyChangeRequestDecision?
  messages      AgencyChangeRequestMessage[]
  workItems     AgencyChangeRequestWorkItem[]
  application   AgencyChangeRequestApplication?
