  lead              CrmLead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  thread            CrmEmailThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  enrollment        CrmSequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  execution         CrmSequenceExecution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  replyToOutbound   CrmEmail?              @relation("EmailReplyThread", fields: [replyToOutboundId], references: [id], onDelete: SetNull)
  inboundReplies    CrmEmail[]             @relation("EmailReplyThread")
  inboundImport     InboundMessageImport?
  trackedLinks      CrmTrackedLink[]
  engagementEvents  CrmEmailEngagementEvent[]
  createdBy         AdminUser              @relation("CrmEmailCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([mailboxKey, mailboxUidValidity, mailboxUid])
  @@index([contactId, createdAt])
  @@index([contactId, receivedAt])
  @@index([contactId, firstOpenDetectedAt])
  @@index([contactId, firstClickDetectedAt])
  @@index([dealId])
  @@index([leadId])
  @@index([enrollmentId])
  @@index([origin, createdAt])
  @@index([direction, receivedAt])
  @@index([reviewStatus, receivedAt])
  @@index([threadId, receivedAt])
  @@index([inReplyToMessageId])
}

model CrmTrackedLink {
