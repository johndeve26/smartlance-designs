  isArchived  Boolean          @default(false)
  isSystem    Boolean          @default(false)
  createdById String
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy AdminUser  @relation("AgencyTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy AdminUser? @relation("AgencyTemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  milestones   AgencyProjectTemplateMilestone[]
  tasks        AgencyProjectTemplateTask[]
  requirements AgencyProjectTemplateRequirement[]

  @@index([isArchived, serviceType])
}

model AgencyProjectTemplateMilestone {
  id              String  @id @default(cuid())
  templateId      String
  title           String
  description     String? @db.Text
  position        Int
  offsetDaysStart Int?
  offsetDaysDue   Int?
  clientVisible   Boolean @default(true)

  template AgencyProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
