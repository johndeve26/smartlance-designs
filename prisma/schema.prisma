model TopicDiscoveryRun {
  id                   String            @id @default(cuid())
  watchlistId          String?
  mode                 TopicDiscoveryMode @default(MIXED)
  status               AIRunStatus       @default(QUEUED)
  seedText             String?           @db.Text
  market               String?
  industry             String?
  freshnessPreference  String?
  commercialGoal       String?
  sourcePreference     String?
  forceRefresh         Boolean           @default(false)
  providersUsedJson    Json?
  signalsFound         Int               @default(0)
  clustersCreated      Int               @default(0)
  opportunitiesCreated Int               @default(0)
  tokenUsageInput      Int?
  tokenUsageOutput     Int?
  providerCalls        Int               @default(0)
  errorCode            String?
  errorSummary         String?           @db.Text
  startedAt            DateTime?
  completedAt          DateTime?
  createdById          String?
  createdAt            DateTime          @default(now())

  watchlist     TopicWatchlist?        @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  createdBy     AdminUser?             @relation("TopicDiscoveryRunner", fields: [createdById], references: [id], onDelete: SetNull)
  signals       TopicSignal[]
  opportunities EditorialOpportunity[]

  @@index([status, createdAt])
  @@index([watchlistId, status])
}

model TopicSignal {
  id                 String              @id @default(cuid())
  runId              String?
  provider           String
  type               TopicSignalType
  title              String
  summary            String?             @db.Text
  sourceUrl          String?
  sourceDomain       String?
  publishedAt        DateTime?
  discoveredAt       DateTime            @default(now())
  market             String?
  language           String?             @default("en")
  entitiesJson       Json?
  topicsJson         Json?
  rawProviderId      String?
  sourceAuthorityType TopicSourceAuthority @default(INDUSTRY)
  freshness          TopicFreshnessClass @default(HYBRID)
  status             TopicSignalStatus   @default(ACTIVE)
  fingerprint        String
  clusterKey         String?
  provenanceJson     Json?
  createdAt          DateTime            @default(now())

  run TopicDiscoveryRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([status, discoveredAt])
  @@index([clusterKey])
  @@index([type, discoveredAt])
  @@index([runId])
}

model EditorialOpportunity {
  id                    String                 @id @default(cuid())
  workingTitle          String
  coreTopic             String                 @db.Text
  question              String?                @db.Text
  status                TopicOpportunityStatus @default(NEW)
  recommendation        TopicRecommendation    @default(MONITOR)
  /// Engine recommendation at creation; preserved when humans override.
  aiOriginalRecommendation TopicRecommendation?
  humanDecisionNote     String?                @db.Text
  editorialFeedback     TopicEditorialFeedback?
  editorialFeedbackNote String?                @db.Text
  intent                String?
  audience              String?
  market                String?
  timeliness            TopicFreshnessClass    @default(HYBRID)
  evergreenPotential    Boolean                @default(true)
  commercialRelationship String?               @db.Text
  uniqueValue           String?                @db.Text
  reasonToExist         String?                @db.Text
  whyNow                String?                @db.Text
  whySmartlance         String?                @db.Text
  existingContentJson   Json?
  supportingSignalsJson Json?
  sourceSummaryJson     Json?
  suggestedServicesJson Json?
  suggestedSolutionsJson Json?
  suggestedPlatformsJson Json?
  suggestedResourcesJson Json?
  /// Resolved CMS target for handoffs (optional; preferred over title matching)
  targetEntityType      String?
  targetEntityId        String?
  suggestedFormat       TopicContentFormat     @default(INSIGHT)
  suggestedCta          String?
  dimensionsJson        Json?
  badge                 String?
  priority              TopicPriority          @default(NORMAL)
  pinned                Boolean                @default(false)
  plannedFor            DateTime?
  rejectionReason       TopicRejectionReason?
  rejectionNote         String?                @db.Text
  higherFactualReview   Boolean                @default(false)
  mergeKey              String?
  evidenceCount         Int                    @default(0)
  recurringSignal       Boolean                @default(false)
  seedId                String?
  runId                 String?
  linkedAIProjectId     String?                @unique
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  seed            TopicSeed?         @relation(fields: [seedId], references: [id], onDelete: SetNull)
  run             TopicDiscoveryRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewedBy      AdminUser?         @relation("TopicOpportunityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  linkedAIProject AIEditorialProject? @relation(fields: [linkedAIProjectId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([recommendation, status])
  @@index([mergeKey])
  @@index([priority, status])
  @@index([market])
}

