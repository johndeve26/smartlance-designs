  CONTENT
  DEPLOYMENT
  DOMAIN
  SSL
  OTHER
}

enum AgencyWebsiteCareEventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NEEDS_ATTENTION
}

enum AgencySupportRequestCategory {
  WEBSITE_CHANGE
  CONTENT_UPDATE
  TECHNICAL_ISSUE
  QUESTION
  ACCESS_HELP
  NEW_FEATURE
  OTHER
}

enum AgencySupportRequestPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AgencySupportRequestStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum AgencySupportWaitingOn {
  SMARTLANCE
  CLIENT
  NONE
}

enum AgencySupportMessageAuthorType {
  CLIENT
  SMARTLANCE
}

model AgencySupportRequestCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AgencyManagedWebsite {
  id                String                        @id @default(cuid())
  companyId         String?
  primaryProjectId  String?
  name              String
  domain            String                        @unique
  productionUrl     String?
  platform          AgencyManagedWebsitePlatform?
  status            AgencyManagedWebsiteStatus    @default(ACTIVE)
  careStatus        AgencyManagedWebsiteCareStatus @default(NOT_ENROLLED)
  carePlanName      String?
  launchDate        DateTime?
  clientSummary     String?                       @db.Text
  clientVisibleNotes String?                      @db.Text
  nextMaintenanceAt DateTime?
  lastMaintenanceAt DateTime?
  observedStatus    AgencyWebsiteObservedStatus?  @default(UNKNOWN)
  statusSource      AgencyWebsiteStatusSource     @default(UNKNOWN)
  lastCheckedAt     DateTime?
  sslStatusLabel    String?
  hostingLabel      String?
  createdById       String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  archivedAt        DateTime?

  company        CrmCompany?                      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryProject AgencyProject?                   @relation(fields: [primaryProjectId], references: [id], onDelete: SetNull)
  createdBy      AdminUser                        @relation("AgencyManagedWebsiteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  clientAccess   AgencyManagedWebsiteClientAccess[]
  careEvents     AgencyWebsiteCareEvent[]
  supportRequests AgencySupportRequest[]

  @@index([companyId, status])
}

model AgencyManagedWebsiteClientAccess {
  id           String                         @id @default(cuid())
  websiteId    String
  contactId    String
  portalUserId String?
  role         AgencyManagedWebsiteClientRole @default(MEMBER)
  grantedAt    DateTime                       @default(now())
  revokedAt    DateTime?
  grantedById  String

  website    AgencyManagedWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  contact    CrmContact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser?    @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser            @relation("AgencyManagedWebsiteAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([websiteId, contactId])
  @@index([portalUserId, websiteId])
}

model AgencyWebsiteCareEvent {
  id            String                      @id @default(cuid())
  websiteId     String
  type          AgencyWebsiteCareEventType  @default(MAINTENANCE)
  status        AgencyWebsiteCareEventStatus @default(SCHEDULED)
  title         String
  clientSummary String?                     @db.Text
  internalNotes String?                     @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  performedById String?
  clientVisible Boolean                     @default(true)
  metadataJson  Json?
  createdAt     DateTime                    @default(now())

  website     AgencyManagedWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  performedBy AdminUser?           @relation("AgencyWebsiteCareEventPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([websiteId, completedAt])
}

model AgencySupportRequest {
  id                      String                       @id @default(cuid())
  supportNumber           String                       @unique
  websiteId               String
  projectId               String?
  submittedByPortalUserId String
  submittedByContactId    String
  category                AgencySupportRequestCategory @default(OTHER)
  priority                AgencySupportRequestPriority @default(NORMAL)
  status                  AgencySupportRequestStatus   @default(OPEN)
  subject                 String
  description             String                       @db.Text
  waitingOn               AgencySupportWaitingOn       @default(SMARTLANCE)
  assignedToId            String?
  changeRequestId         String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  resolvedAt              DateTime?
  closedAt                DateTime?

  website         AgencyManagedWebsite @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  project         AgencyProject?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submittedByPortal ClientPortalUser   @relation("AgencySupportRequestSubmitter", fields: [submittedByPortalUserId], references: [id], onDelete: Restrict)
  submittedByContact CrmContact        @relation(fields: [submittedByContactId], references: [id], onDelete: Restrict)
  assignedTo      AdminUser?           @relation("AgencySupportRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  changeRequest   AgencyChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  messages        AgencySupportMessage[]
  files           AgencySupportRequestFile[]

  @@index([websiteId, status])
  @@index([submittedByPortalUserId])
  @@index([updatedAt])
}

model AgencySupportMessage {
  id               String                         @id @default(cuid())
  supportRequestId String
  authorType       AgencySupportMessageAuthorType
  portalUserId     String?
  adminUserId      String?
  body             String                         @db.Text
  clientVisible    Boolean                        @default(true)
  createdAt        DateTime                       @default(now())

  supportRequest AgencySupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  portalUser     ClientPortalUser?    @relation("AgencySupportMessagePortal", fields: [portalUserId], references: [id], onDelete: SetNull)
  adminUser      AdminUser?           @relation("AgencySupportMessageAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([supportRequestId, createdAt])
}

model AgencySupportRequestFile {
  id                      String   @id @default(cuid())
  supportRequestId        String
  projectFileId           String
  clientVisible           Boolean  @default(true)
  submittedByPortalUserId String?
  submittedByAdminUserId  String?
  createdAt               DateTime @default(now())

  supportRequest        AgencySupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  projectFile           AgencyProjectFile    @relation(fields: [projectFileId], references: [id], onDelete: Restrict)
  submittedByPortalUser ClientPortalUser?    @relation("AgencySupportRequestFilePortal", fields: [submittedByPortalUserId], references: [id], onDelete: SetNull)
  submittedByAdminUser  AdminUser?           @relation("AgencySupportRequestFileAdmin", fields: [submittedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([supportRequestId])
}

// --- Prospect Experience V1 ---

enum AgencyWebsiteReviewStatus {
  PENDING
  FETCHING
  ANALYZING
  COMPLETED
  FAILED
}

enum AgencyWebsiteReviewOverallDirection {
  STRONG_FOUNDATION
  FOCUSED_IMPROVEMENTS
  SIGNIFICANT_OPPORTUNITY
  INSUFFICIENT_DATA
}

enum AgencyWebsiteReviewFindingSeverity {
  HIGH
  MEDIUM
  LOW
}

enum AgencyWebsiteReviewFindingConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AgencyWebsiteBriefStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum AgencyProspectRequestStatus {
  SUBMITTED
  BEING_REVIEWED
  NEEDS_INFORMATION
  PROPOSAL_READY
  CLOSED
}

enum AgencyProspectRequestSourceDetail {
  FREE_WEBSITE_REVIEW
  WEBSITE_BRIEF
  PROSPECT_WORKSPACE
}

enum AgencyProspectRequestMessageAuthorType {
  PORTAL_USER
  SMARTLANCE
}

enum AgencyProspectRequestActivityType {
  REQUEST_SUBMITTED
  INFORMATION_REQUESTED
  PROSPECT_RESPONDED
  STATUS_CHANGED
  PROPOSAL_READY
}

model AgencyProspectProfile {
  id              String   @id @default(cuid())
  portalUserId    String   @unique
  firstName       String?
  lastName        String?
  companyName     String?
  phone           String?
  primaryWebsite  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  requests   AgencyProspectRequest[]

  @@index([updatedAt])
}

model AgencyWebsiteReview {
  id                String                              @id @default(cuid())
  portalUserId      String?
  claimTokenHash    String?                             @unique
  claimTokenUsedAt  DateTime?
  websiteUrl        String
  normalizedDomain  String
  businessName      String?
  goalJson          Json?
  status            AgencyWebsiteReviewStatus           @default(PENDING)
  overallDirection  AgencyWebsiteReviewOverallDirection?
  summary           String?                             @db.Text
  aiFailedMessage   String?
  promptVersion     String?
  modelMetadataSafe Json?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  pages      AgencyWebsiteReviewPage[]
  evidence   AgencyWebsiteReviewEvidence[]
  findings   AgencyWebsiteReviewFinding[]
  briefs     AgencyWebsiteBrief[]
  requests   AgencyProspectRequest[]

  @@index([portalUserId, createdAt])
  @@index([normalizedDomain, createdAt])
  @@index([status])
}

model AgencyWebsiteReviewPage {
  id          String   @id @default(cuid())
  reviewId    String
  url         String
  title       String?
  statusCode  Int?
  contentHash String?
  fetchedAt   DateTime @default(now())

  review   AgencyWebsiteReview           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  evidence AgencyWebsiteReviewEvidence[]

  @@index([reviewId])
}

model AgencyWebsiteReviewEvidence {
  id             String   @id @default(cuid())
  reviewId       String
  pageId         String?
  category       String
  type           String
  label          String
  valueText      String?  @db.Text
  valueNumber    Float?
  booleanValue   Boolean?
  sourceUrl      String?
  sourceSelector String?
  excerpt        String?  @db.Text
  createdAt      DateTime @default(now())

  review   AgencyWebsiteReview                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  page     AgencyWebsiteReviewPage?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  findings AgencyWebsiteReviewFindingEvidence[]

  @@index([reviewId, category])
}

model AgencyWebsiteReviewFinding {
  id             String                              @id @default(cuid())
  reviewId       String
  category       String
  severity       AgencyWebsiteReviewFindingSeverity
  title          String
  explanation    String                              @db.Text
  recommendation String?                             @db.Text
  confidence     AgencyWebsiteReviewFindingConfidence
  position       Int                                 @default(0)
  isPriority     Boolean                             @default(false)
  isStrength     Boolean                             @default(false)
  createdAt      DateTime                            @default(now())

  review    AgencyWebsiteReview                  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  evidence  AgencyWebsiteReviewFindingEvidence[]

  @@index([reviewId, position])
}

model AgencyWebsiteReviewFindingEvidence {
  findingId  String
  evidenceId String

  finding  AgencyWebsiteReviewFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence AgencyWebsiteReviewEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([findingId, evidenceId])
  @@index([evidenceId])
}

model AgencyWebsiteBrief {
  id                   String                   @id @default(cuid())
  portalUserId         String?
  claimTokenHash       String?                  @unique
  claimTokenUsedAt     DateTime?
  title                String                   @default("Website Project Brief")
  projectType          String?
  status               AgencyWebsiteBriefStatus @default(DRAFT)
  sourceReviewId       String?
  schemaVersion        Int                      @default(1)
  answersJson          Json                     @default("{}")
  completionPercent    Int                      @default(0)
  completedSectionIds  Json                     @default("[]")
  submittedSnapshotJson Json?
  submittedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  portalUser   ClientPortalUser?    @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  sourceReview AgencyWebsiteReview? @relation(fields: [sourceReviewId], references: [id], onDelete: SetNull)
  requests     AgencyProspectRequest[]

  @@index([portalUserId, updatedAt])
  @@index([portalUserId, status])
}

model AgencyProspectRequest {
  id                       String                            @id @default(cuid())
  requestNumber            String                            @unique
  portalUserId             String
  prospectProfileId        String?
  contactId                String?
  briefId                  String?
  reviewId                 String?
  status                   AgencyProspectRequestStatus       @default(SUBMITTED)
  title                    String
  projectType              String?
  sourceDetail             AgencyProspectRequestSourceDetail
  submissionIdempotencyKey String                            @unique
  briefSnapshotJson        Json
  reviewSnapshotJson       Json?
  contactSnapshotJson      Json?
  submittedAt              DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  closedAt                 DateTime?

  portalUser      ClientPortalUser         @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  prospectProfile AgencyProspectProfile?   @relation(fields: [prospectProfileId], references: [id], onDelete: SetNull)
  contact         CrmContact?              @relation("AgencyProspectRequestContact", fields: [contactId], references: [id], onDelete: SetNull)
  brief           AgencyWebsiteBrief?      @relation(fields: [briefId], references: [id], onDelete: SetNull)
  review          AgencyWebsiteReview?     @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  proposal        AgencyProposal?
  messages        AgencyProspectRequestMessage[]
  activities      AgencyProspectRequestActivity[]

  @@index([portalUserId, status])
  @@index([portalUserId, submittedAt])
  @@index([contactId])
}

model AgencyProspectRequestMessage {
  id           String                                 @id @default(cuid())
  requestId    String
  authorType   AgencyProspectRequestMessageAuthorType
  portalUserId String?
  adminUserId  String?
  body         String                                 @db.Text
  createdAt    DateTime                               @default(now())

  request    AgencyProspectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser?     @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  adminUser  AdminUser?            @relation("AgencyProspectRequestMessageAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model AgencyProspectRequestActivity {
  id        String                            @id @default(cuid())
  requestId String
  type      AgencyProspectRequestActivityType
  summary   String
  metadata  Json?
  createdAt DateTime                          @default(now())

  request AgencyProspectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model AgencyProspectRequestCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}
