  assignee  AdminUser?             @relation("AgencyTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy AdminUser              @relation("AgencyTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([assigneeId, status, dueDate])
  @@index([projectId, position])
