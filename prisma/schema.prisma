  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  clientCompany   CrmCompany?  @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  primaryContact  CrmContact   @relation(fields: [primaryContactId], references: [id], onDelete: Restrict)
  sourceDeal      CrmDeal?     @relation(fields: [sourceDealId], references: [id], onDelete: SetNull)
  owner           AdminUser    @relation("AgencyProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       AdminUser    @relation("AgencyProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  members       AgencyProjectMember[]
  milestones    AgencyProjectMilestone[]
  tasks         AgencyProjectTask[]
  requirements  AgencyClientRequirement[]
  deliverables  AgencyDeliverable[]
  activities    AgencyProjectActivity[]
  updates       AgencyProjectUpdate[]
  notes         AgencyProjectNote[]
  clientAccess  AgencyProjectClientAccess[]
  files         AgencyProjectFile[]
  portalInvites ClientPortalInvite[]
  sourceProposal AgencyProposal? @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)
  sourceProposalAcceptance AgencyProposalAcceptance? @relation(fields: [sourceProposalAcceptanceId], references: [id], onDelete: SetNull)
  contracts AgencyContract[]
  billingSchedules AgencyBillingSchedule[]
  invoices AgencyInvoice[]
  retainers AgencyRetainer[]
  onboardings AgencyProjectOnboarding[]
  changeRequests AgencyChangeRequest[]
  managedWebsites AgencyManagedWebsite[]
  supportRequests AgencySupportRequest[]

  @@index([status, targetDueDate])
  @@index([ownerId, status])
  @@index([clientCompanyId])
  @@index([primaryContactId])
  @@index([createdAt])
}

model AgencyProjectMember {
  id        String                  @id @default(cuid())
  projectId String
  userId    String
  role      AgencyProjectMemberRole @default(MEMBER)
  createdAt DateTime                @default(now())

  project AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    AdminUser     @relation("AgencyProjectMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AgencyProjectTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?          @db.Text
  serviceType AgencyServiceType
  systemKey   String?          @unique
  isArchived  Boolean          @default(false)
  isSystem    Boolean          @default(false)
  createdById String
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy AdminUser  @relation("AgencyTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy AdminUser? @relation("AgencyTemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  milestones   AgencyProjectTemplateMilestone[]
  tasks        AgencyProjectTemplateTask[]
  requirements AgencyProjectTemplateRequirement[]

  @@index([isArchived, serviceType])
}

model AgencyProjectTemplateMilestone {
  id              String  @id @default(cuid())
  templateId      String
  title           String
  description     String? @db.Text
  position        Int
  offsetDaysStart Int?
  offsetDaysDue   Int?
  clientVisible   Boolean @default(true)

  template AgencyProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    AgencyProjectTemplateTask[]

  @@index([templateId, position])
}

model AgencyProjectTemplateTask {
  id              String                    @id @default(cuid())
  templateId      String
  milestoneId     String?
  title           String
  description     String?                   @db.Text
  position        Int
  priority        AgencyProjectTaskPriority @default(NORMAL)
  offsetDaysDue   Int?
  clientVisible   Boolean                   @default(false)
  defaultRole     AgencyProjectMemberRole?

  template  AgencyProjectTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  milestone AgencyProjectTemplateMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([templateId, position])
}

model AgencyProjectTemplateRequirement {
  id            String                @id @default(cuid())
  templateId    String
  title         String
  description   String?               @db.Text
  type          AgencyRequirementType @default(OTHER)
  offsetDaysDue Int?
  clientVisible Boolean               @default(true)

  template AgencyProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AgencyProjectMilestone {
  id            String                @id @default(cuid())
  projectId     String
  title         String
  description   String?               @db.Text
  status        AgencyMilestoneStatus @default(NOT_STARTED)
  position      Int
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  clientVisible Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project      AgencyProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        AgencyProjectTask[]
  requirements AgencyClientRequirement[]
  deliverables AgencyDeliverable[]
  billingInstallments AgencyBillingInstallment[]

  @@index([projectId, position])
  @@index([projectId, status])
}

model AgencyProjectTask {
  id             String                    @id @default(cuid())
  projectId      String
  milestoneId    String?
  title          String
  description    String?                   @db.Text
  status         AgencyProjectTaskStatus   @default(TODO)
  priority       AgencyProjectTaskPriority @default(NORMAL)
  assigneeId     String?
  createdById    String
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  clientVisible  Boolean                   @default(false)
  position       Int                       @default(0)
  blockedReason  String?                   @db.Text
  changeRequestId String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  project   AgencyProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone AgencyProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  AdminUser?             @relation("AgencyTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy AdminUser              @relation("AgencyTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  changeRequest AgencyChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId, status, dueDate])
  @@index([projectId, position])
  @@index([changeRequestId])
}

model AgencyClientRequirement {
  id            String                  @id @default(cuid())
  projectId     String
  milestoneId   String?
  onboardingId  String?
  onboardingSectionId String?
  sourceQuestionId String?
  sourceTemplateKey String?
  title         String
  description   String?                 @db.Text
  type          AgencyRequirementType   @default(OTHER)
  status        AgencyRequirementStatus @default(REQUESTED)
  required      Boolean                 @default(true)
  dueDate       DateTime?
  clientVisible Boolean                 @default(true)
  assignedContactId String?
  clientReviewNote String?              @db.Text
  internalReviewNote String?            @db.Text
  accessMetadataJson Json?
  fulfilledAt   DateTime?
  changeRequestId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project   AgencyProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone AgencyProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  onboarding AgencyProjectOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  onboardingSection AgencyOnboardingSection? @relation(fields: [onboardingSectionId], references: [id], onDelete: SetNull)
  assignedContact CrmContact? @relation("RequirementAssignedContact", fields: [assignedContactId], references: [id], onDelete: SetNull)
  fileSubmissions AgencyOnboardingFileSubmission[]
  reminders AgencyOnboardingReminder[]
  changeRequest AgencyChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([onboardingId, status])
  @@index([changeRequestId])
  @@unique([onboardingId, sourceTemplateKey])
}

model AgencyDeliverable {
  id            String                  @id @default(cuid())
  projectId     String
  milestoneId   String?
  title         String
  description   String?                 @db.Text
  type          AgencyDeliverableType   @default(OTHER)
  status        AgencyDeliverableStatus @default(DRAFT)
  clientVisible Boolean                 @default(true)
  createdById   String
  changeRequestId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project   AgencyProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone AgencyProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy AdminUser               @relation("AgencyDeliverableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  changeRequest AgencyChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  versions AgencyDeliverableVersion[]
  reviews  AgencyDeliverableReview[]

  @@index([projectId, status])
  @@index([changeRequestId])
}

model AgencyDeliverableVersion {
  id            String    @id @default(cuid())
  deliverableId String
  versionNumber Int
  externalUrl   String?
  notes         String?   @db.Text
  submittedAt   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  deliverable AgencyDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdBy   AdminUser         @relation("AgencyDeliverableVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  file        AgencyProjectFile?
  reviews     AgencyDeliverableReview[]

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
}

model AgencyDeliverableReview {
  id                  String                          @id @default(cuid())
  deliverableId       String
  versionId           String
  reviewerContactId   String?
  reviewerPortalUserId String?
  decision            AgencyDeliverableReviewDecision
  comment             String?                         @db.Text
  isAdminOverride     Boolean                         @default(false)
  createdAt           DateTime                        @default(now())

  deliverable        AgencyDeliverable        @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  version            AgencyDeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewerContact    CrmContact?              @relation(fields: [reviewerContactId], references: [id], onDelete: SetNull)
  reviewerPortalUser ClientPortalUser?        @relation(fields: [reviewerPortalUserId], references: [id], onDelete: SetNull)

  @@index([deliverableId, createdAt])
}

model AgencyProjectActivity {
  id                 String                    @id @default(cuid())
  projectId          String
  type               AgencyProjectActivityType
  summary            String
  actorUserId        String?
  actorPortalUserId  String?
  entityType         String?
  entityId           String?
  metadata           Json?
  clientVisible      Boolean                   @default(false)
  createdAt          DateTime                  @default(now())

  project           AgencyProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser         AdminUser?       @relation("AgencyActivityAdmin", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPortalUser   ClientPortalUser? @relation(fields: [actorPortalUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model AgencyProjectUpdate {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  body          String   @db.Text
  clientVisible Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())

  project   AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy AdminUser     @relation("AgencyUpdateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model AgencyProjectNote {
  id          String   @id @default(cuid())
  projectId   String
  body        String   @db.Text
  createdById String
  createdAt   DateTime @default(now())

  project   AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy AdminUser     @relation("AgencyNoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model AgencyProjectFile {
  id              String   @id @default(cuid())
  projectId       String
  versionId       String?  @unique
  filename        String
  mimeType        String
  byteSize        Int
  storageProvider String
  storageKey      String   @unique
  createdById     String
  createdAt       DateTime @default(now())

  project   AgencyProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   AgencyDeliverableVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  createdBy AdminUser                 @relation("AgencyFileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  onboardingSubmissions AgencyOnboardingFileSubmission[]
  changeRequestFiles    AgencyChangeRequestFile[]
  supportRequestFiles   AgencySupportRequestFile[]

  @@index([projectId])
}

model ClientPortalUser {
  id          String                 @id @default(cuid())
  contactId   String                 @unique
  email       String
  status      ClientPortalUserStatus @default(INVITED)
  lastLoginAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  contact  CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  invites  ClientPortalInvite[]
  sessions ClientPortalSession[]
  projectAccess AgencyProjectClientAccess[]
  reviews  AgencyDeliverableReview[]
  activities AgencyProjectActivity[]
  proposalAccess AgencyProposalClientAccess[]
  proposalResponses AgencyProposalClientResponse[]
  proposalAcceptances AgencyProposalAcceptance[]
  proposalActivities AgencyProposalActivity[]
  contractAccess AgencyContractClientAccess[]
  contractSignatures AgencyContractSignature[]
  contractResponses AgencyContractResponse[]
  contractActivities AgencyContractActivity[]
  contractSigners AgencyContractSigner[]
  invoiceClientAccess AgencyInvoiceClientAccess[]
  clientBillingAccess AgencyClientBillingAccess[]
  billingActivities AgencyBillingActivity[]
  onboardingResponses AgencyOnboardingResponse[] @relation("AgencyOnboardingResponsePortalUser")
  onboardingFileSubmissions AgencyOnboardingFileSubmission[] @relation("AgencyOnboardingFileSubmissionPortalUser")
  onboardingActivities AgencyOnboardingActivity[] @relation("AgencyOnboardingActivityPortal")
  onboardingReminders AgencyOnboardingReminder[] @relation("AgencyOnboardingReminderPortalUser")
  changeRequestsRequested AgencyChangeRequest[] @relation("AgencyChangeRequestPortalRequester")
  changeRequestRevisions AgencyChangeRequestRevision[] @relation("AgencyChangeRequestRevisionPortal")
  changeRequestAccess AgencyChangeRequestClientAccess[] @relation("AgencyChangeRequestClientAccessPortal")
  changeRequestApprovals AgencyChangeRequestApproval[] @relation("AgencyChangeRequestApprovalPortal")
  changeRequestDecisions AgencyChangeRequestDecision[] @relation("AgencyChangeRequestDecisionPortal")
  changeRequestMessages AgencyChangeRequestMessage[] @relation("AgencyChangeRequestMessagePortal")
  changeRequestActivities AgencyChangeRequestActivity[] @relation("AgencyChangeRequestActivityPortal")
  changeRequestFiles AgencyChangeRequestFile[] @relation("AgencyChangeRequestFilePortal")
  managedWebsiteAccess AgencyManagedWebsiteClientAccess[]
  supportRequestsSubmitted AgencySupportRequest[] @relation("AgencySupportRequestSubmitter")
  supportMessages AgencySupportMessage[] @relation("AgencySupportMessagePortal")
  supportRequestFiles AgencySupportRequestFile[] @relation("AgencySupportRequestFilePortal")
  prospectProfile AgencyProspectProfile?
  websiteReviews AgencyWebsiteReview[]
  websiteBriefs AgencyWebsiteBrief[]
  prospectRequests AgencyProspectRequest[]
  prospectRequestMessages AgencyProspectRequestMessage[]

  @@index([email])
  @@index([status])
}

model ClientPortalInvite {
  id           String                 @id @default(cuid())
  portalUserId String
  projectId    String?
  tokenHash    String                 @unique
  status       ClientPortalInviteStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime               @default(now())

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  project    AgencyProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  AdminUser        @relation("PortalInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([portalUserId, status])
  @@index([expiresAt])
}

model ClientPortalSession {
  id           String    @id @default(cuid())
  portalUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@index([expiresAt])
}

model AgencyProjectClientAccess {
  id           String                  @id @default(cuid())
  projectId    String
  contactId    String
  portalUserId String?
  role         AgencyProjectClientRole @default(CLIENT_MEMBER)
  grantedAt    DateTime                @default(now())
  revokedAt    DateTime?
  grantedById  String

  project    AgencyProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact    CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser         @relation("AgencyClientAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([projectId, contactId])
  @@index([portalUserId, projectId])
  @@index([contactId])
}

// --- Agency Proposals V2 ---

enum AgencyProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  CHANGES_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  ARCHIVED
}

enum AgencyProposalLineItemType {
  SERVICE
  ADD_ON
  DISCOUNT
  OTHER
}

enum AgencyProposalClientRole {
  VIEWER
  DECISION_MAKER
}

enum AgencyProposalClientResponseType {
  CHANGES_REQUESTED
  DECLINED
}

enum AgencyProposalActivityType {
  PROPOSAL_CREATED
  VERSION_CREATED
  SENT
  VIEWED
  CHANGES_REQUESTED
  DECLINED
  ACCEPTED
  PROJECT_CREATED
}

enum AgencyProposalSectionType {
  OVERVIEW
  GOALS
  SCOPE
  DELIVERABLES
  TIMELINE
  PRICING
  ASSUMPTIONS
  EXCLUSIONS
  REVISION_POLICY
  NEXT_STEPS
  CLIENT_RESPONSIBILITIES
}

model AgencyProposalCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AgencyProposal {
  id                      String               @id @default(cuid())
  proposalNumber          String               @unique
  dealId                  String?
  companyId               String?
  primaryContactId        String
  sourceProspectRequestId String?              @unique
  title                   String
  summary                 String?              @db.Text
  status                  AgencyProposalStatus @default(DRAFT)
  currency          String               @default("USD")
  currentVersionId  String?
  acceptedVersionId String?
  ownerId           String
  createdById       String
  internalNotes     String?              @db.Text
  sentAt            DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  deal                  CrmDeal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company               CrmCompany?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact        CrmContact             @relation("AgencyProposalPrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  sourceProspectRequest AgencyProspectRequest? @relation(fields: [sourceProspectRequestId], references: [id], onDelete: SetNull)
  owner                 AdminUser              @relation("AgencyProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy             AdminUser              @relation("AgencyProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)

  versions     AgencyProposalVersion[]
  clientAccess AgencyProposalClientAccess[]
  responses    AgencyProposalClientResponse[]
  acceptance   AgencyProposalAcceptance?
  activities   AgencyProposalActivity[]
  project      AgencyProject?
  contracts    AgencyContract[]
  invoices     AgencyInvoice[]

  @@index([status, updatedAt])
  @@index([ownerId, status])
  @@index([dealId])
  @@index([companyId])
  @@index([primaryContactId])
}

model AgencyProposalVersion {
  id                String    @id @default(cuid())
  proposalId        String
  versionNumber     Int
  title             String
  intro             String?   @db.Text
  scopeSummary      String?   @db.Text
  timelineSummary   String?   @db.Text
  estimatedStart    DateTime?
  estimatedDuration String?
  pricingSubtotal   Decimal   @db.Decimal(12, 2)
  discountAmount    Decimal?  @db.Decimal(12, 2)
  taxAmount         Decimal?  @db.Decimal(12, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")
  assumptionsText   String?   @db.Text
  exclusionsText    String?   @db.Text
  termsSummary      String?   @db.Text
  revisionPolicy    String?   @db.Text
  validUntil        DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  publishedAt       DateTime?

  proposal     AgencyProposal                  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy    AdminUser                       @relation("AgencyProposalVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections     AgencyProposalSection[]
  scopeItems   AgencyProposalScopeItem[]
  deliverables AgencyProposalDeliverableItem[]
  lineItems    AgencyProposalLineItem[]
  responses    AgencyProposalClientResponse[]

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model AgencyProposalSection {
  id                String                    @id @default(cuid())
  proposalVersionId String
  sectionType       AgencyProposalSectionType
  title             String
  body              String?                   @db.Text
  position          Int

  version AgencyProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([proposalVersionId, position])
}

model AgencyProposalScopeItem {
  id                String  @id @default(cuid())
  proposalVersionId String
  title             String
  description       String? @db.Text
  position          Int
  included          Boolean @default(true)
  clientVisible     Boolean @default(true)

  version AgencyProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([proposalVersionId, position])
}

model AgencyProposalDeliverableItem {
  id                String  @id @default(cuid())
  proposalVersionId String
  title             String
  description       String? @db.Text
  quantity          Int     @default(1)
  position          Int

  version AgencyProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([proposalVersionId, position])
}

model AgencyProposalLineItem {
  id                  String                     @id @default(cuid())
  proposalVersionId   String
  name                String
  description         String?                    @db.Text
  quantity            Decimal                    @db.Decimal(10, 2)
  unitPrice           Decimal                    @db.Decimal(12, 2)
  amount              Decimal                    @db.Decimal(12, 2)
  position            Int
  type                AgencyProposalLineItemType @default(SERVICE)
  isOptional          Boolean                    @default(false)
  isSelectedByDefault Boolean                    @default(false)

  version AgencyProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@index([proposalVersionId, position])
}

model AgencyProposalClientAccess {
  id            String                   @id @default(cuid())
  proposalId    String
  contactId     String
  portalUserId  String?
  role          AgencyProposalClientRole @default(VIEWER)
  grantedAt     DateTime                 @default(now())
  revokedAt     DateTime?
  grantedById   String
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  proposal   AgencyProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  contact    CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser         @relation("AgencyProposalAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([proposalId, contactId])
  @@index([portalUserId, proposalId])
  @@index([contactId])
}

model AgencyProposalClientResponse {
  id           String                           @id @default(cuid())
  proposalId   String
  versionId    String
  portalUserId String
  contactId    String
  responseType AgencyProposalClientResponseType
  comment      String?                          @db.Text
  createdAt    DateTime                         @default(now())

  proposal   AgencyProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    AgencyProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser      @relation(fields: [portalUserId], references: [id], onDelete: Restrict)
  contact    CrmContact            @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
}

model AgencyProposalAcceptance {
  id                      String   @id @default(cuid())
  proposalId              String   @unique
  acceptedVersionId       String
  portalUserId            String
  contactId               String
  acceptedAt              DateTime @default(now())
  acceptedTotal           Decimal  @db.Decimal(12, 2)
  currency                String
  selectedOptionalItemIds Json
  scopeHash               String?
  termsAcknowledged       Boolean  @default(true)

  proposal   AgencyProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser   @relation(fields: [portalUserId], references: [id], onDelete: Restrict)
  contact    CrmContact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  project    AgencyProject?
  contracts  AgencyContract[]
  billingSchedules AgencyBillingSchedule[]
  invoices   AgencyInvoice[]
  changeRequests AgencyChangeRequest[]

  @@index([acceptedVersionId])
}

model AgencyProposalActivity {
  id                String                     @id @default(cuid())
  proposalId        String
  type              AgencyProposalActivityType
  summary           String
  actorUserId       String?
  actorPortalUserId String?
  entityType        String?
  entityId          String?
  metadata          Json?
  clientVisible     Boolean                    @default(false)
  createdAt         DateTime                   @default(now())

  proposal        AgencyProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actorUser       AdminUser?        @relation("AgencyProposalActivityAdmin", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPortalUser ClientPortalUser? @relation(fields: [actorPortalUserId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
}

// --- Agency Contracts V2.1 ---

enum AgencyContractStatus {
  DRAFT
  READY_FOR_REVIEW
  SENT
  PARTIALLY_SIGNED
  SIGNED
  CORRECTION_REQUESTED
  DECLINED
  EXPIRED
  VOIDED
  ARCHIVED
}

enum AgencyContractType {
  SERVICE_AGREEMENT
  NDA
  MAINTENANCE
  OTHER
}

enum AgencyContractSource {
  MANUAL
  PROPOSAL_ACCEPTANCE
}

enum AgencyContractSignerType {
  CLIENT
  AGENCY
}

enum AgencyContractSignerRole {
  CLIENT_SIGNATORY
  AGENCY_SIGNATORY
  VIEWER
}

enum AgencyContractSignerStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum AgencyContractResponseType {
  CORRECTION_REQUESTED
  DECLINED
}

enum AgencyContractActivityType {
  CONTRACT_CREATED
  VERSION_CREATED
  CONTRACT_SENT
  CONTRACT_VIEWED
  SIGNATURE_COMPLETED
  CORRECTION_REQUESTED
  CONTRACT_DECLINED
  CONTRACT_FULLY_SIGNED
  CONTRACT_VOIDED
  CONTRACT_ARCHIVED
}

enum AgencyContractTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model AgencyContractCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AgencyContractTemplate {
  id               String                       @id @default(cuid())
  name             String
  description      String?                      @db.Text
  status           AgencyContractTemplateStatus @default(DRAFT)
  currentVersionId String?
  createdById      String
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  createdBy AdminUser                       @relation("AgencyContractTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  AgencyContractTemplateVersion[]

  @@index([status, updatedAt])
}

model AgencyContractTemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  versionNumber Int
  name          String
  content       String   @db.Text
  createdById   String
  createdAt     DateTime @default(now())

  template AgencyContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model AgencyContract {
  id                   String               @id @default(cuid())
  contractNumber       String               @unique
  proposalId           String?
  proposalAcceptanceId String?
  projectId            String?
  companyId            String?
  primaryContactId     String?
  title                String
  contractType         AgencyContractType   @default(SERVICE_AGREEMENT)
  source               AgencyContractSource @default(MANUAL)
  status               AgencyContractStatus @default(DRAFT)
  currentVersionId     String?
  signedVersionId      String?
  ownerId              String
  createdById          String
  internalNotes        String?              @db.Text
  sentAt               DateTime?
  fullySignedAt        DateTime?
  declinedAt           DateTime?
  voidedAt             DateTime?
  voidReason           String?              @db.Text
  expiresAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  proposal           AgencyProposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalAcceptance AgencyProposalAcceptance? @relation(fields: [proposalAcceptanceId], references: [id], onDelete: SetNull)
  project            AgencyProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company            CrmCompany?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact     CrmContact?               @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  owner              AdminUser                 @relation("AgencyContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy          AdminUser                 @relation("AgencyContractCreator", fields: [createdById], references: [id], onDelete: Restrict)

  versions     AgencyContractVersion[]
  signers      AgencyContractSigner[]
  clientAccess AgencyContractClientAccess[]
  signatures   AgencyContractSignature[]
  responses    AgencyContractResponse[]
  activities   AgencyContractActivity[]
  billingSchedules AgencyBillingSchedule[]
  invoices     AgencyInvoice[]
  retainers    AgencyRetainer[]
  changeRequests AgencyChangeRequest[]

  @@index([status, updatedAt])
  @@index([ownerId, status])
  @@index([proposalId])
  @@index([proposalAcceptanceId])
  @@index([projectId])
  @@index([companyId])
}

model AgencyContractVersion {
  id                      String    @id @default(cuid())
  contractId              String
  versionNumber           Int
  title                   String
  content                 String    @db.Text
  resolvedVariables       Json?
  sourceTemplateId        String?
  sourceTemplateVersionId String?
  proposalAcceptanceId    String?
  proposalScopeHash       String?
  contentHash             String
  publishedAt             DateTime?
  createdById             String
  createdAt               DateTime  @default(now())

  contract   AgencyContract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy  AdminUser                 @relation("AgencyContractVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signers    AgencyContractSigner[]
  signatures AgencyContractSignature[]
  responses  AgencyContractResponse[]

  @@unique([contractId, versionNumber])
  @@index([contractId])
}

model AgencyContractSigner {
  id                String                     @id @default(cuid())
  contractId        String
  contractVersionId String?
  signerType        AgencyContractSignerType
  portalUserId      String?
  adminUserId       String?
  contactId         String?
  nameSnapshot      String
  emailSnapshot     String
  companySnapshot   String?
  role              AgencyContractSignerRole
  signingOrder      Int                        @default(1)
  isRequired        Boolean                    @default(true)
  status            AgencyContractSignerStatus @default(PENDING)
  invitedAt         DateTime?
  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  contract   AgencyContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version    AgencyContractVersion?  @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  portalUser ClientPortalUser?       @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  adminUser  AdminUser?              @relation("AgencyContractSignerAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  contact    CrmContact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  signatures AgencyContractSignature[]

  @@index([contractId, status])
  @@index([portalUserId])
  @@index([adminUserId])
}

model AgencyContractClientAccess {
  id            String                   @id @default(cuid())
  contractId    String
  contactId     String
  portalUserId  String?
  role          AgencyContractSignerRole @default(VIEWER)
  grantedAt     DateTime                 @default(now())
  revokedAt     DateTime?
  grantedById   String
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  contract   AgencyContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contact    CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser         @relation("AgencyContractAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([contractId, contactId])
  @@index([portalUserId, contractId])
}

model AgencyContractSignature {
  id                  String   @id @default(cuid())
  contractId          String
  contractVersionId   String
  signerId            String
  signerPortalUserId  String?
  signerAdminUserId   String?
  contactId           String?
  signerNameSnapshot  String
  signerEmailSnapshot String
  typedSignatureName  String
  signerTitle         String?
  consentTextSnapshot String   @db.Text
  consentVersion      String
  contractContentHash String
  signedAt            DateTime @default(now())
  ipHash              String?
  userAgentHash       String?
  createdAt           DateTime @default(now())

  contract   AgencyContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version    AgencyContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  signer     AgencyContractSigner  @relation(fields: [signerId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser?     @relation(fields: [signerPortalUserId], references: [id], onDelete: SetNull)
  adminUser  AdminUser?            @relation("AgencyContractSignatureAdmin", fields: [signerAdminUserId], references: [id], onDelete: SetNull)
  contact    CrmContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([contractVersionId, signerId])
  @@index([contractId])
}

model AgencyContractResponse {
  id           String                     @id @default(cuid())
  contractId   String
  versionId    String
  portalUserId String?
  adminUserId  String?
  contactId    String?
  responseType AgencyContractResponseType
  comment      String?                    @db.Text
  createdAt    DateTime                   @default(now())

  contract   AgencyContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version    AgencyContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser?     @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  contact    CrmContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
}

model AgencyContractActivity {
  id                String                     @id @default(cuid())
  contractId        String
  type              AgencyContractActivityType
  summary           String
  actorUserId       String?
  actorPortalUserId String?
  entityType        String?
  entityId          String?
  metadata          Json?
  clientVisible     Boolean                    @default(false)
  createdAt         DateTime                   @default(now())

  contract        AgencyContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorUser       AdminUser?        @relation("AgencyContractActivityAdmin", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPortalUser ClientPortalUser? @relation(fields: [actorPortalUserId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
}

// --- Agency Billing V2.2 ---

enum AgencyInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  WRITTEN_OFF
}

enum AgencyInvoiceSource {
  MANUAL
  PROPOSAL_ACCEPTANCE
  CONTRACT
  PROJECT
  RETAINER
  SCHEDULE
  CHANGE_REQUEST
}

enum AgencyPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  NEEDS_REVIEW
}

enum AgencyPaymentMethod {
  CARD
  BANK_TRANSFER
  ONLINE_TRANSFER
  CASH
  OTHER
}

enum AgencyPaymentProvider {
  MANUAL
  PAYSTACK
}

enum AgencyPaymentSource {
  PORTAL
  ADMIN_MANUAL
  WEBHOOK
  VERIFY
}

enum AgencyBillingScheduleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AgencyBillingInstallmentType {
  DEPOSIT
  MILESTONE
  FINAL
  OTHER
}

enum AgencyBillingInstallmentStatus {
  PENDING
  INVOICED
  PAID
}

enum AgencyRetainerStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum AgencyRetainerInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AgencyRetainerIssueMode {
  CREATE_DRAFT
  AUTO_ISSUE
}

enum AgencyBillingClientAccessRole {
  BILLING_ADMIN
  VIEWER
}

enum AgencyBillingActivityType {
  INVOICE_CREATED
  INVOICE_ISSUED
  INVOICE_VIEWED
  INVOICE_VOIDED
  INVOICE_WRITTEN_OFF
  PAYMENT_INITIATED
  PAYMENT_RECEIVED
  PAYMENT_PARTIAL
  INVOICE_PAID
  MANUAL_PAYMENT_RECORDED
  PAYMENT_ANOMALY
  RETAINER_INVOICE_GENERATED
  REMINDER_SENT
}

enum AgencyPaymentWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model AgencyBillingSettings {
  id                       String                  @id @default("agency-billing")
  defaultCurrency          String                  @default("USD")
  defaultPaymentTermsDays  Int                     @default(14)
  businessLegalName        String?
  billingEmail             String?
  billingAddressJson       Json?
  taxLabel                 String?
  taxRateBasisPoints       Int?
  paymentInstructions      String?                 @db.Text
  retainerDefaultIssueMode AgencyRetainerIssueMode @default(CREATE_DRAFT)
  paystackEnabled          Boolean                 @default(false)
  updatedAt                DateTime                @updatedAt
}

model AgencyBillingProfile {
  id              String   @id @default(cuid())
  companyId       String?
  contactId       String?
  legalName       String
  billingEmail    String
  billingPhone    String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  stateRegion     String?
  postalCode      String?
  countryCode     String?
  taxIdentifier   String?
  taxLabel        String?
  defaultCurrency String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  CrmCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices AgencyInvoice[]

  @@index([companyId])
  @@index([contactId])
}

model AgencyInvoiceCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AgencyPaymentCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AgencyBillingSchedule {
  id                   String                      @id @default(cuid())
  proposalAcceptanceId String?
  contractId           String?
  projectId            String?
  currency             String
  totalScheduledMinor  Int
  status               AgencyBillingScheduleStatus @default(DRAFT)
  createdById          String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  proposalAcceptance AgencyProposalAcceptance? @relation(fields: [proposalAcceptanceId], references: [id], onDelete: SetNull)
  contract           AgencyContract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project            AgencyProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy          AdminUser                 @relation("AgencyBillingScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  installments       AgencyBillingInstallment[]
  invoices           AgencyInvoice[]
}

model AgencyBillingInstallment {
  id                    String                         @id @default(cuid())
  billingScheduleId     String
  sequence              Int
  label                 String
  type                  AgencyBillingInstallmentType   @default(OTHER)
  amountMinor           Int
  percentageBasisPoints Int?
  milestoneId           String?
  dueDate               DateTime?
  dueDaysOffset         Int?
  invoiceId             String?
  status                AgencyBillingInstallmentStatus @default(PENDING)
  createdAt             DateTime                       @default(now())

  schedule       AgencyBillingSchedule   @relation(fields: [billingScheduleId], references: [id], onDelete: Cascade)
  milestone      AgencyProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  invoice        AgencyInvoice?          @relation("InstallmentInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  linkedInvoices AgencyInvoice[]         @relation("InvoiceInstallment")

  @@unique([billingScheduleId, sequence])
}

model AgencyInvoice {
  id                       String              @id @default(cuid())
  invoiceNumber            String              @unique
  source                   AgencyInvoiceSource @default(MANUAL)
  companyId                String?
  primaryContactId         String?
  billingProfileId         String?
  proposalId               String?
  proposalAcceptanceId     String?
  contractId               String?
  projectId                String?
  retainerId               String?
  billingScheduleId        String?
  billingInstallmentId     String?
  billingPeriodStart       DateTime?
  billingPeriodEnd         DateTime?
  status                   AgencyInvoiceStatus @default(DRAFT)
  currency                 String
  subtotalMinor            Int                 @default(0)
  discountMinor            Int                 @default(0)
  taxMinor                 Int                 @default(0)
  totalMinor               Int                 @default(0)
  amountPaidMinor          Int                 @default(0)
  amountDueMinor           Int                 @default(0)
  issueDate                DateTime?
  dueDate                  DateTime?
  sentAt                   DateTime?
  paidAt                   DateTime?
  voidedAt                 DateTime?
  voidReason               String?             @db.Text
  writtenOffAt             DateTime?
  writeOffReason           String?             @db.Text
  billingNameSnapshot      String?
  billingEmailSnapshot     String?
  billingAddressSnapshotJson Json?
  issuerNameSnapshot       String?
  issuerEmailSnapshot      String?
  memo                     String?             @db.Text
  clientNotes              String?             @db.Text
  internalNotes            String?             @db.Text
  snapshotHash             String?
  allowPartialPayment      Boolean             @default(false)
  changeRequestId          String?             @unique
  createdById              String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  company            CrmCompany?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact     CrmContact?               @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  billingProfile     AgencyBillingProfile?     @relation(fields: [billingProfileId], references: [id], onDelete: SetNull)
  proposal           AgencyProposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalAcceptance AgencyProposalAcceptance? @relation(fields: [proposalAcceptanceId], references: [id], onDelete: SetNull)
  contract           AgencyContract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project            AgencyProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  retainer           AgencyRetainer?           @relation(fields: [retainerId], references: [id], onDelete: SetNull)
  billingSchedule    AgencyBillingSchedule?    @relation(fields: [billingScheduleId], references: [id], onDelete: SetNull)
  billingInstallment AgencyBillingInstallment? @relation("InvoiceInstallment", fields: [billingInstallmentId], references: [id], onDelete: SetNull)
  createdBy          AdminUser                 @relation("AgencyInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  changeRequest      AgencyChangeRequest?      @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  lineItems        AgencyInvoiceLineItem[]
  allocations      AgencyPaymentAllocation[]
  clientAccess     AgencyInvoiceClientAccess[]
  activities       AgencyBillingActivity[]
  retainerPeriods  AgencyRetainerBillingPeriod[]
  installmentLinks AgencyBillingInstallment[]  @relation("InstallmentInvoice")

  @@index([status, dueDate])
  @@index([companyId])
  @@index([projectId])
  @@index([proposalAcceptanceId])
  @@index([contractId])
  @@index([retainerId])
}

model AgencyInvoiceLineItem {
  id              String  @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Int     @default(1)
  unitAmountMinor Int
  amountMinor     Int
  position        Int     @default(0)
  sourceType      String?
  sourceId        String?

  invoice AgencyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AgencyPayment {
  id                    String                @id @default(cuid())
  paymentReference      String?               @unique
  companyId             String?
  contactId             String?
  provider              AgencyPaymentProvider
  providerTransactionId String?
  providerReference     String?
  status                AgencyPaymentStatus   @default(PENDING)
  currency              String
  amountMinor           Int
  method                AgencyPaymentMethod   @default(OTHER)
  source                AgencyPaymentSource   @default(PORTAL)
  metadataJson          Json?
  receivedAt            DateTime?
  confirmedAt           DateTime?
  failedAt              DateTime?
  confirmationEmailSentAt    DateTime?
  confirmationEmailClaimedAt DateTime?
  recordedById          String?
  manualNote            String?               @db.Text
  clientRequestId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  company       CrmCompany?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       CrmContact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recordedBy    AdminUser?                  @relation("AgencyPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  allocations   AgencyPaymentAllocation[]
  webhookEvents AgencyPaymentWebhookEvent[]
  activities    AgencyBillingActivity[]

  @@unique([provider, providerTransactionId])
  @@index([status, createdAt])
}

model AgencyPaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountMinor Int
  createdAt   DateTime @default(now())

  payment AgencyPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice AgencyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentId])
}

model AgencyPaymentWebhookEvent {
  id              String                     @id @default(cuid())
  provider        AgencyPaymentProvider
  providerEventId String
  eventType       String
  payloadHash     String
  status          AgencyPaymentWebhookStatus @default(RECEIVED)
  paymentId       String?
  errorSafe       String?
  receivedAt      DateTime                   @default(now())
  processedAt     DateTime?

  payment AgencyPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
}

model AgencyRetainer {
  id                  String                  @id @default(cuid())
  companyId           String
  primaryContactId    String?
  projectId           String?
  contractId          String?
  name                String
  description         String?                 @db.Text
  status              AgencyRetainerStatus    @default(DRAFT)
  currency            String
  amountMinor         Int
  billingInterval     AgencyRetainerInterval  @default(MONTHLY)
  billingDay          Int?
  issueMode           AgencyRetainerIssueMode @default(CREATE_DRAFT)
  lineItemDescription String
  startDate           DateTime
  endDate             DateTime?
  nextBillingDate     DateTime?
  paymentTermsDays    Int                     @default(14)
  ownerId             String
  createdById         String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  company        CrmCompany                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact CrmContact?                 @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  project        AgencyProject?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract       AgencyContract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner          AdminUser                   @relation("AgencyRetainerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy      AdminUser                   @relation("AgencyRetainerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  billingPeriods AgencyRetainerBillingPeriod[]
  invoices       AgencyInvoice[]
  activities     AgencyBillingActivity[]

  @@index([status, nextBillingDate])
}

model AgencyRetainerBillingPeriod {
  id          String   @id @default(cuid())
  retainerId  String
  periodStart DateTime
  periodEnd   DateTime
  invoiceId   String?
  createdAt   DateTime @default(now())

  retainer AgencyRetainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  invoice  AgencyInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([retainerId, periodStart])
}

model AgencyInvoiceClientAccess {
  id            String                        @id @default(cuid())
  invoiceId     String
  contactId     String
  portalUserId  String?
  role          AgencyBillingClientAccessRole @default(VIEWER)
  grantedAt     DateTime                      @default(now())
  revokedAt     DateTime?
  grantedById   String
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  invoice    AgencyInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contact    CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser         @relation("AgencyInvoiceAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([invoiceId, contactId])
  @@index([portalUserId, invoiceId])
}

model AgencyClientBillingAccess {
  id           String                        @id @default(cuid())
  companyId    String?
  contactId    String
  portalUserId String?
  role         AgencyBillingClientAccessRole @default(VIEWER)
  grantedAt    DateTime                      @default(now())
  revokedAt    DateTime?
  grantedById  String

  company    CrmCompany?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalUser ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  grantedBy  AdminUser         @relation("AgencyClientBillingAccessGranter", fields: [grantedById], references: [id], onDelete: Restrict)

