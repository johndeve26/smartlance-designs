enum CrmSequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CrmSequenceStepType {
  EMAIL
  TASK
  WAIT
}

enum CrmSequenceTaskAdvanceMode {
  AUTO_CONTINUE
  WAIT_FOR_TASK_COMPLETION
}

enum CrmSequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CrmSequenceStopReason {
  SUPPRESSED
  ARCHIVED
  LEAD_DISQUALIFIED
  DEAL_WON
  MANUAL
  OPT_OUT
  MANUAL_REPLY
  OUTREACH_PAUSED
  ERROR
  REPLY_RECEIVED
  AUTOMATED_REPLY
}

enum CrmSequenceExecutionStatus {
  PENDING
  PROCESSING
  SENT
  COMPLETED
  FAILED
  SKIPPED
  AMBIGUOUS
}

model CrmSegment {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  filterJson    Json
  filterVersion Int      @default(1)
  isDynamic     Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy AdminUser @relation("CrmSegmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([updatedAt])
  @@index([createdById])
}

model CrmSequence {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  status      CrmSequenceStatus @default(DRAFT)
  version     Int               @default(1)
  createdById String
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy   AdminUser              @relation("CrmSequenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   AdminUser?             @relation("CrmSequenceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  steps       CrmSequenceStep[]
  enrollments CrmSequenceEnrollment[]

  @@index([status, updatedAt])
}

model CrmSequenceStep {
  id               String                     @id @default(cuid())
  sequenceId       String
  position         Int
  type             CrmSequenceStepType
  delayDays        Int                        @default(0)
  delayMinutes     Int                        @default(0)
  emailTemplateId  String?
  subject          String?
  body             String?                    @db.Text
  taskTitle        String?
  taskDescription  String?                    @db.Text
  taskAdvanceMode  CrmSequenceTaskAdvanceMode @default(AUTO_CONTINUE)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  sequence      CrmSequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  emailTemplate CrmEmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  executions    CrmSequenceExecution[]

  @@unique([sequenceId, position])
  @@index([sequenceId])
}

model CrmSequenceEnrollment {
  id              String                      @id @default(cuid())
  sequenceId      String
  sequenceVersion Int
  contactId       String
  leadId          String?
  status          CrmSequenceEnrollmentStatus @default(ACTIVE)
  currentStep     Int                         @default(0)
  nextRunAt       DateTime?
  startedAt       DateTime                    @default(now())
  pausedAt        DateTime?
  completedAt     DateTime?
  stoppedAt       DateTime?
  stopReason      CrmSequenceStopReason?
  stopNote        String?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  sequence   CrmSequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact    CrmContact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead       CrmLead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy  AdminUser              @relation("CrmEnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  executions CrmSequenceExecution[]
  emails     CrmEmail[]

  @@index([status, nextRunAt])
  @@index([contactId])
  @@index([sequenceId, status])
}

model CrmSequenceExecution {
  id             String                     @id @default(cuid())
  enrollmentId   String
  stepId         String
  status         CrmSequenceExecutionStatus @default(PENDING)
  scheduledAt    DateTime
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  executedAt     DateTime?
  failureCode    String?
  failureCategory String?
  attemptCount   Int                        @default(0)
  skipReason     String?
  subjectSnap    String?
  bodySnap       String?                    @db.Text
  createdTaskId  String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  enrollment CrmSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       CrmSequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  email      CrmEmail?

  @@unique([enrollmentId, stepId])
  @@index([status, scheduledAt])
  @@index([enrollmentId])
}

model CrmOutreachSettings {
  id                        String   @id @default("outreach")
  maxDailySequenceEmails    Int      @default(50)
  minContactEmailGapHours   Int      @default(24)
  minStepDelayMinutes       Int      @default(60)
  sendWeekdaysOnly          Boolean  @default(true)
  sendWindowStartUtc        Int      @default(8)
  sendWindowEndUtc          Int      @default(18)
  outreachFooter            String?  @db.Text
  outreachPaused            Boolean  @default(false)
  trackEmailOpens           Boolean  @default(false)
  trackEmailClicks          Boolean  @default(true)
  engagementTrackingUpdatedAt DateTime?
  updatedAt                 DateTime @updatedAt
}

model CrmOutreachOptOut {
  id        String    @id @default(cuid())
  contactId String    @unique
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

