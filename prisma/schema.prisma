model AgencyOnboardingTemplate {
  id               String                       @id @default(cuid())
  name             String
  description      String?                      @db.Text
  serviceType      AgencyServiceType?
  status           AgencyOnboardingTemplateStatus @default(DRAFT)
  systemKey        String?                      @unique
  currentVersionId String?
  welcomeText      String?                      @db.Text
  createdById      String
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  createdBy AdminUser @relation("AgencyOnboardingTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  AgencyOnboardingTemplateVersion[]
  onboardings AgencyProjectOnboarding[]

  @@index([status])
}

model AgencyOnboardingTemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  versionNumber Int
  welcomeText   String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())

  template     AgencyOnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy    AdminUser                @relation("AgencyOnboardingTemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections     AgencyOnboardingTemplateSection[]
  questions    AgencyOnboardingTemplateQuestion[]
  requirements AgencyOnboardingTemplateRequirement[]
  onboardings  AgencyProjectOnboarding[]

  @@unique([templateId, versionNumber])
}

model AgencyOnboardingTemplateSection {
  id            String  @id @default(cuid())
  versionId     String
  title         String
  description   String? @db.Text
  position      Int     @default(0)
  clientVisible Boolean @default(true)

  version      AgencyOnboardingTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions    AgencyOnboardingTemplateQuestion[]
  requirements AgencyOnboardingTemplateRequirement[]
}

model AgencyOnboardingTemplateQuestion {
  id             String                     @id @default(cuid())
  versionId      String
  sectionId      String
  key            String
  label          String
  description    String?                    @db.Text
  type           AgencyOnboardingQuestionType @default(SHORT_TEXT)
  required       Boolean                    @default(false)
  position       Int                        @default(0)
  placeholder    String?
  helpText       String?                    @db.Text
  optionsJson    Json?
  validationJson Json?
  clientVisible  Boolean                    @default(true)

  version AgencyOnboardingTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section AgencyOnboardingTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
}

model AgencyOnboardingTemplateRequirement {
  id           String                @id @default(cuid())
  versionId    String
  sectionId    String?
  sourceKey    String
  title        String
  description  String?               @db.Text
  type         AgencyRequirementType @default(OTHER)
  required     Boolean               @default(true)
  position     Int                   @default(0)
  clientVisible Boolean              @default(true)
  offsetDaysDue Int?

  version AgencyOnboardingTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section AgencyOnboardingTemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([versionId, sourceKey])
}

model AgencyProjectOnboarding {
  id                     String                     @id @default(cuid())
  projectId              String
  templateId             String?
  templateVersionId      String?
  status                 AgencyOnboardingStatus     @default(NOT_STARTED)
  waitingOn              AgencyOnboardingWaitingOn  @default(NONE)
  ownerId                String?
  primaryClientContactId String?
  startedAt              DateTime?
  submittedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  targetCompletionDate   DateTime?
  clientMessage          String?                    @db.Text
  internalNotes          String?                    @db.Text
  reminderMode           AgencyOnboardingReminderMode @default(MANUAL)
  lastClientActivityAt   DateTime?
  lastReminderAt         DateTime?
  reminderCount          Int                        @default(0)
  createdById            String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  project         AgencyProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        AgencyOnboardingTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion AgencyOnboardingTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  owner           AdminUser?                     @relation("AgencyOnboardingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryClientContact CrmContact?               @relation("AgencyOnboardingPrimaryContact", fields: [primaryClientContactId], references: [id], onDelete: SetNull)
  createdBy       AdminUser                      @relation("AgencyOnboardingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections        AgencyOnboardingSection[]
  questions       AgencyOnboardingQuestion[]
  responses       AgencyOnboardingResponse[]
  requirements    AgencyClientRequirement[]
  fileSubmissions AgencyOnboardingFileSubmission[]
  activities      AgencyOnboardingActivity[]
  reminders       AgencyOnboardingReminder[]

  @@index([projectId])
  @@index([status, targetCompletionDate])
  @@index([ownerId, status])
}

model AgencyOnboardingSection {
  id            String   @id @default(cuid())
  onboardingId  String
  title         String
  description   String?  @db.Text
  position      Int      @default(0)
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())

  onboarding   AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  questions    AgencyOnboardingQuestion[]
  requirements AgencyClientRequirement[]

  @@index([onboardingId, position])
}

model AgencyOnboardingQuestion {
  id             String                     @id @default(cuid())
  onboardingId   String
  sectionId      String
  key            String
  label          String
  description    String?                    @db.Text
  type           AgencyOnboardingQuestionType @default(SHORT_TEXT)
  required       Boolean                    @default(false)
  position       Int                        @default(0)
  placeholder    String?
  helpText       String?                    @db.Text
  optionsJson    Json?
  validationJson Json?
  clientVisible  Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  onboarding      AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  section         AgencyOnboardingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses       AgencyOnboardingResponse[]
  fileSubmissions AgencyOnboardingFileSubmission[]
  reminders       AgencyOnboardingReminder[]

  @@unique([onboardingId, key])
  @@index([onboardingId, sectionId, position])
}

model AgencyOnboardingResponse {
  id                      String                     @id @default(cuid())
  onboardingId            String
  questionId              String
  respondedByPortalUserId String?
  contactId               String?
  valueText               String?                    @db.Text
  valueJson               Json?
  submittedAt             DateTime?
  updatedAt               DateTime                   @updatedAt
  reviewStatus            AgencyOnboardingReviewStatus @default(PENDING)
  reviewedById            String?
  reviewedAt              DateTime?
  reviewNote              String?                    @db.Text

  onboarding            AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  question              AgencyOnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  respondedByPortalUser ClientPortalUser?       @relation("AgencyOnboardingResponsePortalUser", fields: [respondedByPortalUserId], references: [id], onDelete: SetNull)
  contact               CrmContact?             @relation("AgencyOnboardingResponseContact", fields: [contactId], references: [id], onDelete: SetNull)
  reviewedBy            AdminUser?              @relation("AgencyOnboardingResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([onboardingId, questionId])
}

model AgencyOnboardingFileSubmission {
  id                      String    @id @default(cuid())
  onboardingId            String
  requirementId           String?
  questionId              String?
  projectFileId           String
  submittedByPortalUserId String?
  supersededAt            DateTime?
  createdAt               DateTime  @default(now())

  onboarding            AgencyProjectOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
