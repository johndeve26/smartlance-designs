generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  CONTENT_MANAGER
  REVIEWER
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum RedirectStatus {
  ACTIVE
  DISABLED
}

enum RedirectOrigin {
  SLUG_CHANGE
  LEGACY_MIGRATION
  MANUAL
}

enum MediaSourceType {
  STATIC_EXISTING
  UPLOADED
  EXTERNAL
}

enum MediaAssetStatus {
  ACTIVE
  ARCHIVED
}

enum NavigationMenuKey {
  HEADER_PRIMARY
  HEADER_RESOURCES
  HEADER_SERVICES
  HEADER_SEO
  HEADER_PLATFORMS
  HEADER_CTA
  FOOTER_SERVICES
  FOOTER_SEO
  FOOTER_PLATFORMS
  FOOTER_COMPANY
  FOOTER_RESOURCES
  FOOTER_LEGAL
}

enum NavigationItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LinkHealthIssueType {
  BROKEN
  REDIRECTING
  UNPUBLISHED_DESTINATION
  ORPHAN
  INVALID_RELATION
  CANONICAL_MISMATCH
  OPTIONAL_WARNING
}

enum LinkHealthSeverity {
  ERROR
  WARNING
  INFO
}

enum EnquiryType {
  CONTACT
  WEBSITE_REVIEW
}

enum EnquiryStatus {
  NEW
  REVIEWING
  REPLIED
  QUALIFIED
  CLOSED
  SPAM
}

enum NotificationStatus {
  NOT_ATTEMPTED
  SENT
  FAILED
}

model AdminUser {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         AdminRole       @default(EDITOR)
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sessions          AdminSession[]
  auditLogs         AuditLog[]       @relation("AuditActor")
  contentRevisions  ContentRevision[] @relation("RevisionAuthor")
  redirectsCreated  Redirect[]       @relation("RedirectCreator")
  servicesCreated   Service[]        @relation("ServiceCreator")
  servicesUpdated   Service[]        @relation("ServiceUpdater")
  solutionsCreated  Solution[]       @relation("SolutionCreator")
  solutionsUpdated  Solution[]       @relation("SolutionUpdater")
  platformsCreated  Platform[]       @relation("PlatformCreator")
  platformsUpdated  Platform[]       @relation("PlatformUpdater")
  homepageUpdated   HomepageContent[] @relation("HomepageUpdater")
  homepageDraftUpdated HomepageContent[] @relation("HomepageDraftUpdater")
  industriesCreated Industry[]       @relation("IndustryCreator")
  industriesUpdated Industry[]       @relation("IndustryUpdater")
  workCreated       WorkProject[]    @relation("WorkCreator")
  workUpdated       WorkProject[]    @relation("WorkUpdater")
  testimonialsCreated Testimonial[]  @relation("TestimonialCreator")
  testimonialsUpdated Testimonial[]  @relation("TestimonialUpdater")
  insightsCreated   Insight[]        @relation("InsightCreator")
  insightsUpdated   Insight[]        @relation("InsightUpdater")
  resourcesCreated  CmsResource[]    @relation("ResourceCreator")
  resourcesUpdated  CmsResource[]    @relation("ResourceUpdater")
  mediaCreated      MediaAsset[]     @relation("MediaCreator")
  mediaUpdated      MediaAsset[]     @relation("MediaUpdater")
  navMenusUpdated   NavigationMenu[] @relation("NavMenuUpdater")
  managedPagesUpdated ManagedPage[]  @relation("ManagedPageUpdater")
  linkHealthRuns    LinkHealthRun[]  @relation("LinkHealthRunner")
  enquiryNotes      EnquiryNote[]    @relation("EnquiryNoteAuthor")
  enquiriesUpdated  Enquiry[]        @relation("EnquiryUpdater")
  aiProjectsCreated AIEditorialProject[] @relation("AIProjectCreator")
  aiProjectsUpdated AIEditorialProject[] @relation("AIProjectUpdater")
  aiProjectsApproved AIEditorialProject[] @relation("AIProjectApprover")
  aiRunsCreated     AIEditorialRun[]     @relation("AIRunCreator")
  aiBrandVoicesUpdated AIBrandVoice[]    @relation("AIBrandVoiceUpdater")
  aiEvaluationSnapshots AIEvaluationSnapshot[] @relation("AIEvaluationCreator")
  aiProviderAccountsUpdated AIProviderAccount[] @relation("AIProviderAccountUpdater")
  topicSeedsCreated         TopicSeed[]              @relation("TopicSeedCreator")
  topicOpportunitiesReviewed EditorialOpportunity[]  @relation("TopicOpportunityReviewer")
  topicDiscoveryRuns        TopicDiscoveryRun[]      @relation("TopicDiscoveryRunner")
  topicSourcePacksUpdated   TopicSourcePack[]        @relation("TopicSourcePackUpdater")
  topicWatchlistsUpdated    TopicWatchlist[]         @relation("TopicWatchlistUpdater")
  aiContentRunsCreated      AIContentRun[]           @relation("AIContentRunCreator")
  aiContentProposalsCreated AIContentProposal[]      @relation("AIContentProposalCreator")
  aiContentProposalsAccepted AIContentProposal[]     @relation("AIContentProposalAcceptor")
  emailSettingsUpdated      EmailSettings[]          @relation("EmailSettingsUpdater")
  emailSendingProfilesCreated EmailSendingProfile[]  @relation("EmailSendingProfileCreator")
  emailSendingProfilesUpdated EmailSendingProfile[]  @relation("EmailSendingProfileUpdater")
  emailRoutingRulesUpdated  EmailRoutingRule[]       @relation("EmailRoutingRuleUpdater")
  inboundEmailSettingsUpdated InboundEmailSettings[] @relation("InboundEmailSettingsUpdater")
  inboundEmailSyncActor     InboundEmailSettings[]   @relation("InboundEmailSyncActor")
  subscribersUnsubscribed   Subscriber[]             @relation("SubscriberUnsubscriber")
  crmContactsOwned          CrmContact[]             @relation("CrmContactOwner")
  crmContactsCreated        CrmContact[]             @relation("CrmContactCreator")
  crmCompaniesOwned         CrmCompany[]             @relation("CrmCompanyOwner")
  crmLeadsOwned             CrmLead[]                @relation("CrmLeadOwner")
  crmDealsOwned             CrmDeal[]                @relation("CrmDealOwner")
  crmTasksAssigned          CrmTask[]                @relation("CrmTaskAssignee")
  crmTasksCreated           CrmTask[]                @relation("CrmTaskCreator")
  crmActivitiesCreated      CrmActivity[]            @relation("CrmActivityCreator")
  crmEmailsCreated          CrmEmail[]               @relation("CrmEmailCreator")
  crmEmailTemplatesCreated  CrmEmailTemplate[]       @relation("CrmEmailTemplateCreator")
  crmEmailTemplatesUpdated  CrmEmailTemplate[]       @relation("CrmEmailTemplateUpdater")
  crmSegmentsCreated        CrmSegment[]               @relation("CrmSegmentCreator")
  crmSequencesCreated       CrmSequence[]              @relation("CrmSequenceCreator")
  crmSequencesUpdated       CrmSequence[]              @relation("CrmSequenceUpdater")
  crmSequenceEnrollmentsCreated CrmSequenceEnrollment[] @relation("CrmEnrollmentCreator")
  crmContactImportsCreated    CrmContactImport[]      @relation("CrmContactImportCreator")
  crmContactViewsCreated      CrmContactView[]        @relation("CrmContactViewCreator")
  crmPropertyDefinitionsCreated CrmPropertyDefinition[] @relation("CrmPropertyDefinitionCreator")
  crmPropertyDefinitionsUpdated CrmPropertyDefinition[] @relation("CrmPropertyDefinitionUpdater")
  crmThreadsAssigned            CrmEmailThread[]        @relation("CrmThreadAssignee")
  crmThreadUserStates           CrmEmailThreadUserState[] @relation("CrmThreadUserState")
  agencyProjectsOwned           AgencyProject[]           @relation("AgencyProjectOwner")
  agencyProjectsCreated         AgencyProject[]           @relation("AgencyProjectCreator")
  agencyProjectMemberships      AgencyProjectMember[]     @relation("AgencyProjectMember")
  agencyTasksAssigned           AgencyProjectTask[]       @relation("AgencyTaskAssignee")
  agencyTasksCreated            AgencyProjectTask[]       @relation("AgencyTaskCreator")
  agencyTemplatesCreated        AgencyProjectTemplate[]   @relation("AgencyTemplateCreator")
  agencyTemplatesUpdated        AgencyProjectTemplate[]   @relation("AgencyTemplateUpdater")
  agencyDeliverablesCreated     AgencyDeliverable[]       @relation("AgencyDeliverableCreator")
  agencyDeliverableVersionsCreated AgencyDeliverableVersion[] @relation("AgencyDeliverableVersionCreator")
  agencyActivities              AgencyProjectActivity[]   @relation("AgencyActivityAdmin")
  agencyUpdatesCreated          AgencyProjectUpdate[]     @relation("AgencyUpdateCreator")
  agencyNotesCreated            AgencyProjectNote[]       @relation("AgencyNoteCreator")
  agencyFilesCreated            AgencyProjectFile[]       @relation("AgencyFileCreator")
  portalInvitesCreated          ClientPortalInvite[]      @relation("PortalInviteCreator")
  agencyClientAccessGranted     AgencyProjectClientAccess[] @relation("AgencyClientAccessGranter")
  agencyProposalsOwned          AgencyProposal[]          @relation("AgencyProposalOwner")
  agencyProposalsCreated        AgencyProposal[]          @relation("AgencyProposalCreator")
  agencyProposalVersionsCreated AgencyProposalVersion[]   @relation("AgencyProposalVersionCreator")
  agencyProposalAccessGranted   AgencyProposalClientAccess[] @relation("AgencyProposalAccessGranter")
  agencyProposalActivities      AgencyProposalActivity[]  @relation("AgencyProposalActivityAdmin")
  agencyContractsOwned          AgencyContract[]          @relation("AgencyContractOwner")
  agencyContractsCreated        AgencyContract[]          @relation("AgencyContractCreator")
  agencyContractVersionsCreated AgencyContractVersion[] @relation("AgencyContractVersionCreator")
  agencyContractTemplatesCreated AgencyContractTemplate[] @relation("AgencyContractTemplateCreator")
  agencyContractAccessGranted   AgencyContractClientAccess[] @relation("AgencyContractAccessGranter")
  agencyContractActivities      AgencyContractActivity[]  @relation("AgencyContractActivityAdmin")
  agencyContractSignatures      AgencyContractSignature[] @relation("AgencyContractSignatureAdmin")
  agencyContractSigners         AgencyContractSigner[]    @relation("AgencyContractSignerAdmin")
  agencyBillingSchedulesCreated AgencyBillingSchedule[]   @relation("AgencyBillingScheduleCreator")
  agencyInvoicesCreated         AgencyInvoice[]           @relation("AgencyInvoiceCreator")
  agencyPaymentsRecorded        AgencyPayment[]           @relation("AgencyPaymentRecorder")
  agencyRetainersOwned          AgencyRetainer[]          @relation("AgencyRetainerOwner")
  agencyRetainersCreated        AgencyRetainer[]          @relation("AgencyRetainerCreator")
  agencyInvoiceAccessGranted    AgencyInvoiceClientAccess[] @relation("AgencyInvoiceAccessGranter")
  agencyClientBillingAccessGranted AgencyClientBillingAccess[] @relation("AgencyClientBillingAccessGranter")
  agencyBillingActivities       AgencyBillingActivity[]   @relation("AgencyBillingActivityAdmin")
  agencyOnboardingTemplatesCreated AgencyOnboardingTemplate[] @relation("AgencyOnboardingTemplateCreator")
  agencyOnboardingTemplateVersionsCreated AgencyOnboardingTemplateVersion[] @relation("AgencyOnboardingTemplateVersionCreator")
  agencyOnboardingsOwned        AgencyProjectOnboarding[] @relation("AgencyOnboardingOwner")
  agencyOnboardingsCreated      AgencyProjectOnboarding[] @relation("AgencyOnboardingCreator")
  agencyOnboardingResponsesReviewed AgencyOnboardingResponse[] @relation("AgencyOnboardingResponseReviewer")
  agencyOnboardingActivities    AgencyOnboardingActivity[] @relation("AgencyOnboardingActivityAdmin")
  agencyChangeRequestsOwned     AgencyChangeRequest[]      @relation("AgencyChangeRequestOwner")
  agencyChangeRequestsCreated   AgencyChangeRequest[]      @relation("AgencyChangeRequestCreator")
  agencyChangeRequestsRequested AgencyChangeRequest[]      @relation("AgencyChangeRequestAdminRequester")
  agencyChangeRequestRevisions  AgencyChangeRequestRevision[] @relation("AgencyChangeRequestRevisionAdmin")
  agencyChangeRequestAssessments AgencyChangeRequestAssessment[] @relation("AgencyChangeRequestAssessor")
  agencyChangeRequestAccessGranted AgencyChangeRequestClientAccess[] @relation("AgencyChangeRequestAccessGranter")
  agencyChangeRequestMessages   AgencyChangeRequestMessage[] @relation("AgencyChangeRequestMessageAdmin")
  agencyChangeRequestApplications AgencyChangeRequestApplication[] @relation("AgencyChangeRequestApplier")
  agencyChangeRequestActivities AgencyChangeRequestActivity[] @relation("AgencyChangeRequestActivityAdmin")
  agencyChangeRequestFiles      AgencyChangeRequestFile[]  @relation("AgencyChangeRequestFileAdmin")
  managedWebsitesCreated        AgencyManagedWebsite[]     @relation("AgencyManagedWebsiteCreator")
  managedWebsiteAccessGranted   AgencyManagedWebsiteClientAccess[] @relation("AgencyManagedWebsiteAccessGranter")
  websiteCareEventsPerformed    AgencyWebsiteCareEvent[]   @relation("AgencyWebsiteCareEventPerformer")
  supportRequestsAssigned       AgencySupportRequest[]     @relation("AgencySupportRequestAssignee")
  supportMessages               AgencySupportMessage[]     @relation("AgencySupportMessageAdmin")
  supportRequestFiles           AgencySupportRequestFile[] @relation("AgencySupportRequestFileAdmin")
  prospectRequestMessages       AgencyProspectRequestMessage[] @relation("AgencyProspectRequestMessageAdmin")

  @@index([status])
  @@index([role])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipHash    String?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  revision   Int
  snapshot   Json
  createdById String?
  createdAt  DateTime @default(now())

  createdBy AdminUser? @relation("RevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, revision])
  @@index([entityType, entityId])
}

model Redirect {
  id          String         @id @default(cuid())
  sourcePath  String         @unique
  destination String
  type        RedirectType   @default(PERMANENT_301)
  status      RedirectStatus @default(ACTIVE)
  origin      RedirectOrigin @default(MANUAL)
  reason      String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy AdminUser? @relation("RedirectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([origin])
}

model SiteSettings {
  id                     String   @id @default("site")
  siteName               String   @default("Smartlance Designs")
  businessName           String   @default("Smartlance Designs")
  defaultSiteDescription String?
  defaultLocale          String   @default("en")
  timezone               String   @default("Africa/Lagos")
  canonicalHost          String?
  contactEmail           String?
  contactPhone           String?
  whatsapp               String?
  footerDescription      String?
  primaryLogoPath        String?
  logoOnDarkPath         String?
  brandMarkPath          String?
  faviconPath            String?
  defaultMetaTitle       String?
  defaultMetaDescription String?
  defaultOgImagePath     String?
  defaultTitleTemplate   String?
  publisherName          String?
  /// Public analytics IDs only (never secrets)
  gaMeasurementId        String?
  gtmContainerId         String?
  clarityProjectId       String?
  analyticsEnabled       Boolean  @default(true)
  contactFormEnabled     Boolean  @default(true)
  freeReviewFormEnabled  Boolean  @default(true)
  audienceEnabled             Boolean  @default(true)
  audienceRequireConfirmation Boolean  @default(true)
  formSuccessMessage     String?
  formFallbackMessage    String?
  showPublicPricing      Boolean  @default(false)
  robotsDefaultIndex     Boolean  @default(true)
  /// [{ platform, url, enabled, displayOrder }]
  socialLinks            Json     @default("[]")
  /// Flexible extras (never secrets)
  extras                 Json     @default("{}")
  updatedAt              DateTime @updatedAt
  updatedById            String?
}

/// Site-wide SMTP configuration (singleton). Password stored encrypted — never plaintext.
model EmailSettings {
  id                     String    @id @default("site")
  enabled                Boolean   @default(false)
  host                   String?
  port                   Int?
  /// AUTO | TLS | STARTTLS | NONE
  securityMode           String    @default("STARTTLS")
  username               String?
  passwordCiphertext     String?   @db.Text
  passwordIv             String?
  passwordTag            String?
  passwordLast4          String?
  fromName               String?
  fromEmail              String?
  replyToEmail           String?
  /// Validated notification recipient emails (bounded list)
  notificationRecipients Json      @default("[]")
  testRecipient          String?
  lastTestedAt           DateTime?
  lastTestSucceededAt    DateTime?
  lastTestErrorSafe      String?
  updatedAt              DateTime  @updatedAt
  updatedById            String?

  updatedBy AdminUser? @relation("EmailSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum EmailTransportType {
  SYSTEM_SMTP
  CUSTOM_SMTP
}

enum EmailRouteCategory {
  AUTH_MAGIC_LINK
  PROSPECT_GENERAL
  PROSPECT_REQUEST
  PROSPECT_CLARIFICATION
  CRM_MANUAL
  CRM_SEQUENCE
  CRM_INBOUND_REPLY
  PROPOSAL
  CONTRACT
  PROJECT
  ONBOARDING
  CHANGE_REQUEST
  INVOICE
  PAYMENT_CONFIRMATION
  SUPPORT
  GENERAL_SYSTEM
}

enum EmailProfileTestStatus {
  UNTESTED
  PASSED
  FAILED
}

model EmailSendingProfile {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  description        String?                @db.Text
  fromName           String
  fromEmail          String
  replyToName        String?
  replyToEmail       String?
  transportType      EmailTransportType     @default(SYSTEM_SMTP)
  smtpHost           String?
  smtpPort           Int?
  smtpSecurityMode   String?                @default("STARTTLS")
  smtpUsername       String?
  smtpPasswordCiphertext String?            @db.Text
  smtpPasswordIv     String?
  smtpPasswordTag    String?
  smtpPasswordLast4  String?
  isActive           Boolean                @default(false)
  isDefault          Boolean                @default(false)
  sortOrder          Int                    @default(0)
  lastTestedAt       DateTime?
  lastTestStatus     EmailProfileTestStatus @default(UNTESTED)
  lastTestErrorCode  String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdById        String?
  updatedById        String?

  createdBy     AdminUser?          @relation("EmailSendingProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     AdminUser?          @relation("EmailSendingProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  routingRules  EmailRoutingRule[]
  crmEmails     CrmEmail[]

  @@index([isActive, sortOrder])
  @@index([isDefault])
}

model EmailRoutingRule {
  id               String             @id @default(cuid())
  category         EmailRouteCategory @unique
  sendingProfileId String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  updatedById      String?

  sendingProfile EmailSendingProfile @relation(fields: [sendingProfileId], references: [id], onDelete: Restrict)
  updatedBy      AdminUser?          @relation("EmailRoutingRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model InboundEmailSettings {
  id                    String    @id @default("inbound")
  enabled               Boolean   @default(false)
  providerType          String    @default("IMAP")
  host                  String?
  port                  Int?
  securityMode          String    @default("TLS")
  username              String?
  passwordCiphertext    String?   @db.Text
  passwordIv            String?
  passwordTag           String?
  passwordLast4         String?
  mailboxFolder         String    @default("INBOX")
  crmReplyToEmail       String?
  syncEnabledAt         DateTime?
  syncActorId           String?
  lastSyncedAt          DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastSyncErrorSafe     String?
  lastImportCount       Int       @default(0)
  updatedAt             DateTime  @updatedAt
  updatedById           String?

  updatedBy  AdminUser? @relation("InboundEmailSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  syncActor  AdminUser? @relation("InboundEmailSyncActor", fields: [syncActorId], references: [id], onDelete: SetNull)
}

model InboundMailboxState {
  id             String   @id @default("primary")
  mailboxKey     String   @unique
  uidValidity    BigInt?
  lastSeenUid    BigInt   @default(0)
  lastSyncedAt   DateTime?
  lastErrorSafe  String?
  updatedAt      DateTime @updatedAt
}

model CrmEmailThread {
  id                String                   @id @default(cuid())
  contactId         String?
  leadId            String?
  dealId            String?
  subjectNormalized String?
  snippet           String?                  @db.VarChar(280)
  workflowStatus    CrmThreadWorkflowStatus  @default(CLOSED)
  assignedToId      String?
  snoozedUntil      DateTime?
  closedAt          DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  lastActivityAt    DateTime?
  needsReplySince   DateTime?
  lastMessageAt     DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  contact    CrmContact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       CrmLead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal       CrmDeal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedTo AdminUser?               @relation("CrmThreadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  emails     CrmEmail[]
  tasks      CrmTask[]
  userStates CrmEmailThreadUserState[]

  @@index([contactId, lastMessageAt])
  @@index([workflowStatus, lastActivityAt])
  @@index([assignedToId, workflowStatus, lastActivityAt])
  @@index([snoozedUntil])
}

model CrmEmailThreadUserState {
  id         String   @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread CrmEmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   AdminUser      @relation("CrmThreadUserState", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, lastReadAt])
}

model InboundMessageImport {
  id                String   @id @default(cuid())
  mailboxKey        String
  uidValidity       BigInt
  mailboxUid        BigInt
  internetMessageId String?
  crmEmailId        String?  @unique
  status            String   @default("SUCCESS")
  failureSafe       String?
  attemptCount      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  crmEmail CrmEmail? @relation(fields: [crmEmailId], references: [id], onDelete: SetNull)

  @@unique([mailboxKey, uidValidity, mailboxUid])
  @@index([internetMessageId])
}

model HomepageContent {
  id                     String    @id @default("home")
  heroEyebrow            String
  heroHeadline           String
  heroHeadlineAccent     String?
  heroSupporting         String
  primaryCtaLabel        String
  primaryCtaHref         String
  secondaryCtaLabel      String
  secondaryCtaHref       String
  metaTitle              String?
  metaDescription        String?
  sections               Json
  sectionVisibility      Json
  curatedServiceItems    Json
  curatedTestimonialIds  Json
  seoTitle               String?
  seoDescription         String?
  ogTitle                String?
  ogDescription          String?
  ogImagePath            String?
  noIndex                Boolean   @default(false)
  canonicalOverride      String?
  /// Unpublished editor/AI draft — public site never reads this until publish
  draftJson              Json?
  draftUpdatedAt         DateTime?
  draftUpdatedById       String?
  updatedById            String?
  updatedAt              DateTime  @updatedAt

  updatedBy      AdminUser? @relation("HomepageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  draftUpdatedBy AdminUser? @relation("HomepageDraftUpdater", fields: [draftUpdatedById], references: [id], onDelete: SetNull)
}

model Service {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  href                 String        @unique
  title                String
  shortTitle           String?
  category             String
  group                String
  icon                 String
  summary              String
  description          String        @db.Text
  tagline              String?
  narrativeTitle       String?
  narrative            String?       @db.Text
  seoConnection        String?       @db.Text
  audience             String?
  platformsNote        String?
  visualVariant        String?
  featured             Boolean       @default(false)
  navigationFeatured   Boolean       @default(false)
  displayOrder         Int           @default(0)
  capabilities         Json?
  idealFor             Json?
  problems             Json?
  deliverables         Json?
  process              Json?
  evaluationItems      Json?
  faqs                 Json?
  relatedProjectSlugs  Json?
  relatedServiceSlugs  Json?
  relatedSeoSlugs      Json?
  relatedPlatformSlugs Json?
  relatedSolutionSlugs Json?
  ctaTitle             String?
  ctaDescription       String?       @db.Text
  primaryCtaLabel      String?
  primaryCtaHref       String?
  secondaryCtaLabel    String?
  secondaryCtaHref     String?
  seoTitle             String
  seoDescription       String
  ogTitle              String?
  ogDescription        String?
  ogImagePath          String?
  noIndex              Boolean       @default(false)
  canonicalOverride    String?
  status               PublishStatus @default(DRAFT)
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  createdBy AdminUser? @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("ServiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([group])
  @@index([displayOrder])
}

model Solution {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  name                   String
  title                  String
  shortDescription       String        @db.Text
  category               String
  icon                   String
  featured               Boolean       @default(false)
  displayOrder           Int           @default(0)
  eyebrow                String?
  heroStatement          String?       @db.Text
  heroSupporting         String?       @db.Text
  problemSymptoms        Json?
  possibleCauses         Json?
  whatWeReview           Json?
  process                Json?
  measurementPoints      Json?
  relatedServiceHrefs    Json
  relatedPlatformSlugs   Json?
  relatedIndustrySlugs   Json?
  relatedProjectSlugs    Json?
  relatedArticleSlugs    Json?
  relatedServiceReasons  Json?
  relatedSolutions       Json?
  faqs                   Json?
  pageKind               String?
  pageContent            Json?
  ctaTitle               String?
