  bodyTruncated       Boolean                   @default(false)
  attachmentMeta      Json?
  sentAt              DateTime?
  receivedAt          DateTime?
  failedAt            DateTime?
  safeFailureCode     String?
  openTrackingEnabled Boolean                   @default(false)
  clickTrackingEnabled Boolean                  @default(false)
  openTokenHash       String?                   @unique
  firstOpenDetectedAt DateTime?
  lastOpenDetectedAt  DateTime?
  openDetectedCount   Int                       @default(0)
  firstClickDetectedAt DateTime?
  lastClickDetectedAt DateTime?
  clickDetectedCount  Int                       @default(0)
  likelyHumanClickCount Int                     @default(0)
  clientRequestId     String?                   @unique
  createdById         String
  createdAt           DateTime                  @default(now())

  contact           CrmContact?            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal              CrmDeal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead              CrmLead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  thread            CrmEmailThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  enrollment        CrmSequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  execution         CrmSequenceExecution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  replyToOutbound   CrmEmail?              @relation("EmailReplyThread", fields: [replyToOutboundId], references: [id], onDelete: SetNull)
  inboundReplies    CrmEmail[]             @relation("EmailReplyThread")
  inboundImport     InboundMessageImport?
  trackedLinks      CrmTrackedLink[]
