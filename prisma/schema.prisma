model CrmEmail {
  id                  String                    @id @default(cuid())
  contactId           String?
  dealId              String?
  leadId              String?
  threadId            String?
  enrollmentId        String?
  executionId         String?                   @unique
  replyToOutboundId   String?
  origin              CrmEmailOrigin            @default(MANUAL)
  direction           CrmEmailDirection         @default(OUTBOUND)
  subject             String
  bodyText            String                    @db.Text
  bodyHtml            String?                   @db.Text
  deliveryStatus      CrmEmailDeliveryStatus    @default(PENDING)
  reviewStatus        CrmInboundReviewStatus?
  matchConfidence     CrmEmailMatchConfidence?
  providerMessageId   String?
  internetMessageId   String?                   @unique
  inReplyToMessageId  String?
  referencesHeader    String?                   @db.Text
  fromAddress         String?
  sendingProfileId    String?
  fromNameSnapshot    String?
  fromEmailSnapshot   String?
  replyToSnapshot     String?
  transportTypeSnapshot EmailTransportType?
  toAddresses         Json?
  ccAddresses         Json?
  mailboxKey          String?
  mailboxUid          BigInt?
  mailboxUidValidity  BigInt?
