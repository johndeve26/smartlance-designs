  createdBy AdminUser?          @relation("AIContentRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  proposals AIContentProposal[]

  @@index([entityType, entityId, createdAt])
  @@index([status])
  @@index([action])
}

model AIContentProposal {
  id                  String                  @id @default(cuid())
  entityType          AIContentEntityType
  entityId            String
  action              String
  status              AIContentProposalStatus @default(PENDING)
  payloadJson         Json
  currentSnapshotJson Json
  entityUpdatedAt     DateTime
  acceptedFieldsJson  Json?
  rejectedFieldsJson  Json?
  lockedFieldsJson    Json?
  customInstructions  String?                 @db.Text
  promptVersion       String?
  runId               String?
  /// Optional Topic Intelligence opportunity that opened this commercial handoff
  opportunityId       String?
  createdById         String?
  acceptedById        String?
  acceptedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  run        AIContentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdBy  AdminUser?    @relation("AIContentProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy AdminUser?    @relation("AIContentProposalAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, status])
  @@index([createdAt])
  @@index([runId])
  @@index([opportunityId])
}

